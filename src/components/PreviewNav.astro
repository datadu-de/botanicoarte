---
interface Props {
  current: string;
}

const { current } = Astro.props;

const styles = [
  { slug: 'mediterranean', label: 'Mediterranean', desc: 'Terracotta · Sage · Sand' },
  { slug: 'modern',        label: 'Modern',        desc: 'White · Black · Clean' },
  { slug: 'botanical',     label: 'Botanical',     desc: 'Forest Green · Parchment' },
  { slug: 'playful',       label: 'Playful',       desc: 'Coral · Teal · Vibrant' },
  { slug: 'nordic',        label: 'Nordic',        desc: 'Slate · Walnut · Minimal' },
];
---

<div id="preview-nav" style="position:fixed;top:0;left:0;right:0;z-index:1000;background:rgba(15,15,15,0.92);backdrop-filter:blur(10px);border-bottom:1px solid rgba(255,255,255,0.08);">
  <div style="max-width:1280px;margin:0 auto;padding:0 1rem;display:flex;align-items:center;gap:0.75rem;height:52px;overflow-x:auto;scrollbar-width:none;">
    <span style="color:rgba(255,255,255,0.4);font-size:0.7rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;white-space:nowrap;margin-right:0.5rem;">Style Preview</span>
    {styles.map(s => (
      <a
        href={`/preview/${s.slug}`}
        style={`
          display:inline-flex;flex-direction:column;align-items:center;
          padding:0.35rem 0.9rem;border-radius:4px;text-decoration:none;
          white-space:nowrap;transition:all 0.15s ease;border:1px solid;
          ${s.slug === current
            ? 'background:rgba(255,255,255,0.15);border-color:rgba(255,255,255,0.3);'
            : 'background:transparent;border-color:rgba(255,255,255,0.08);'}
        `}
      >
        <span style={`font-size:0.75rem;font-weight:600;${s.slug === current ? 'color:white;' : 'color:rgba(255,255,255,0.6);'}`}>
          {s.label}
        </span>
        <span style="font-size:0.6rem;color:rgba(255,255,255,0.35);margin-top:1px;">{s.desc}</span>
      </a>
    ))}
  </div>
</div>
<div style="height:52px;"></div>
