---
import type { Locale, TranslationKeys } from '../i18n/translations';

interface Props {
  locale: Locale;
  tr: TranslationKeys;
}

const { locale, tr } = Astro.props;

type CourseKey = 'acrylic' | 'watercolor' | 'resin' | 'pottery' | 'private' | 'openStudio';
const courseKeys: CourseKey[] = ['acrylic', 'watercolor', 'resin', 'pottery', 'private', 'openStudio'];

const courseImages: Record<CourseKey, string> = {
  acrylic: 'https://images.unsplash.com/photo-1578926288207-a90a0fd46e64?w=700&q=80',
  watercolor: 'https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?w=700&q=80',
  resin: 'https://images.unsplash.com/photo-1615484478291-fbc12d71abe9?w=700&q=80',
  pottery: 'https://images.unsplash.com/photo-1565193566173-7a0ee3dbe261?w=700&q=80',
  private: 'https://images.unsplash.com/photo-1513364776144-60967b0f800f?w=700&q=80',
  openStudio: 'https://images.unsplash.com/photo-1460661419201-fd4cecdf8a8b?w=700&q=80',
};

const courseColors: Record<CourseKey, string> = {
  acrylic: 'var(--color-terracotta)',
  watercolor: '#5B8FA8',
  resin: 'var(--color-gold)',
  pottery: 'var(--color-sage)',
  private: 'var(--color-terracotta-dark)',
  openStudio: 'var(--color-sage-dark)',
};
---

<!-- Page Hero -->
<section class="py-20" style="background-color: var(--color-blush);">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <span class="section-subtitle block mb-4">{tr.courses.subtitle}</span>
    <h1 class="section-title mb-6">{tr.courses.title}</h1>
    <p class="opacity-70 text-lg max-w-2xl mx-auto">{tr.courses.intro}</p>
  </div>
</section>

<!-- Course list -->
<section class="py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-20">
      {courseKeys.map((key, i) => {
        const course = tr.courses.items[key];
        const isEven = i % 2 === 0;
        return (
          <div class={`grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center ${isEven ? '' : 'lg:[direction:rtl]'}`}>
            <div class={isEven ? '' : 'lg:[direction:ltr]'}>
              <div class="aspect-[4/3] rounded-sm overflow-hidden">
                <img
                  src={courseImages[key]}
                  alt={course.title}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
                  loading="lazy"
                />
              </div>
            </div>
            <div class={isEven ? '' : 'lg:[direction:ltr]'}>
              <div class="inline-block text-xs font-bold tracking-widest uppercase px-3 py-1.5 rounded-full mb-4"
                   style={`background-color: rgba(107,143,113,0.1); color: ${courseColors[key]};`}>
                {course.audience}
              </div>
              <h2 class="text-3xl font-semibold mb-5" style={`font-family: var(--font-display); color: var(--color-espresso);`}>
                {course.title}
              </h2>
              <p class="leading-relaxed mb-8 opacity-75">{course.description}</p>
              <ul class="space-y-3 mb-8">
                {course.details.map(detail => (
                  <li class="flex items-center gap-3 text-sm">
                    <span class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0"
                          style={`background-color: ${courseColors[key]}; color: white;`}>
                      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                      </svg>
                    </span>
                    <span class="opacity-80">{detail}</span>
                  </li>
                ))}
              </ul>
              <div class="flex flex-wrap gap-3">
                <a href={`/${locale}/contact/`} class="btn-primary">{tr.courses.bookNow}</a>
                <a
                  href="https://www.getyourguide.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-outline"
                >GetYourGuide</a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<!-- Bottom CTA -->
<section class="py-16" style="background-color: var(--color-blush);">
  <div class="max-w-3xl mx-auto px-4 text-center">
    <h2 class="section-title mb-4">Not sure which course is right for you?</h2>
    <p class="opacity-70 mb-8">Send us a message and we'll help you find the perfect fit.</p>
    <a href={`/${locale}/contact/`} class="btn-primary">{tr.nav.contact}</a>
  </div>
</section>
