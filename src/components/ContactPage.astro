---
import type { Locale, TranslationKeys } from '../i18n/translations';

interface Props {
  locale: Locale;
  tr: TranslationKeys;
}

const { locale, tr } = Astro.props;
---

<!-- Page Hero -->
<section class="py-20" style="background-color: var(--color-blush);">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <span class="section-subtitle block mb-4">{tr.contact.subtitle}</span>
    <h1 class="section-title mb-6">{tr.contact.title}</h1>
    <p class="opacity-70 text-lg max-w-2xl mx-auto">{tr.contact.intro}</p>
  </div>
</section>

<section class="py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-16">

      <!-- Contact form (3 cols) -->
      <div class="lg:col-span-3">
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          class="space-y-6"
          id="contact-form"
        >
          <input type="hidden" name="form-name" value="contact" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-semibold mb-2" style="color: var(--color-espresso);">
                {tr.contact.nameLabel}
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-sm border text-sm outline-none transition-colors duration-200"
                style="background-color: white; border-color: var(--color-blush); color: var(--color-brown);"
                onfocus="this.style.borderColor='var(--color-terracotta)'"
                onblur="this.style.borderColor='var(--color-blush)'"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold mb-2" style="color: var(--color-espresso);">
                {tr.contact.emailLabel}
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-sm border text-sm outline-none transition-colors duration-200"
                style="background-color: white; border-color: var(--color-blush); color: var(--color-brown);"
                onfocus="this.style.borderColor='var(--color-terracotta)'"
                onblur="this.style.borderColor='var(--color-blush)'"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-sm font-semibold mb-2" style="color: var(--color-espresso);">
              {tr.contact.subjectLabel}
            </label>
            <select
              id="subject"
              name="subject"
              class="w-full px-4 py-3 rounded-sm border text-sm outline-none transition-colors duration-200 cursor-pointer"
              style="background-color: white; border-color: var(--color-blush); color: var(--color-brown);"
              onfocus="this.style.borderColor='var(--color-terracotta)'"
              onblur="this.style.borderColor='var(--color-blush)'"
            >
              <option value="general">{tr.contact.subjectOptions.general}</option>
              <option value="booking">{tr.contact.subjectOptions.booking}</option>
              <option value="private">{tr.contact.subjectOptions.private}</option>
              <option value="resident">{tr.contact.subjectOptions.resident}</option>
              <option value="other">{tr.contact.subjectOptions.other}</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold mb-2" style="color: var(--color-espresso);">
              {tr.contact.messageLabel}
            </label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              class="w-full px-4 py-3 rounded-sm border text-sm outline-none transition-colors duration-200 resize-y"
              style="background-color: white; border-color: var(--color-blush); color: var(--color-brown);"
              onfocus="this.style.borderColor='var(--color-terracotta)'"
              onblur="this.style.borderColor='var(--color-blush)'"
            ></textarea>
          </div>

          <button type="submit" class="btn-primary w-full sm:w-auto">
            {tr.contact.send}
          </button>
        </form>

        <!-- Success message (hidden by default) -->
        <div id="success-msg" class="hidden mt-8 p-6 rounded-sm" style="background-color: var(--color-sage-light); color: var(--color-sage-dark);">
          <h3 class="font-semibold text-lg mb-2" style="font-family: var(--font-display);">{tr.contact.successTitle}</h3>
          <p class="text-sm">{tr.contact.successBody}</p>
        </div>
      </div>

      <!-- Info sidebar (2 cols) -->
      <div class="lg:col-span-2 space-y-8">
        <div class="p-8 rounded-sm" style="background-color: var(--color-blush);">
          <h3 class="text-xl font-semibold mb-6" style="font-family: var(--font-display); color: var(--color-espresso);">
            Arte Botanico
          </h3>
          <ul class="space-y-5">
            <li class="flex gap-4">
              <div class="w-10 h-10 rounded-full flex-shrink-0 flex items-center justify-center"
                   style="background-color: var(--color-terracotta-light);">
                <svg class="w-5 h-5" style="color: var(--color-terracotta-dark);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-sm" style="color: var(--color-espresso);">{tr.contact.info.location}</div>
                <div class="text-xs opacity-60 mt-0.5">{tr.contact.info.locationDetail}</div>
              </div>
            </li>
            <li class="flex gap-4">
              <div class="w-10 h-10 rounded-full flex-shrink-0 flex items-center justify-center"
                   style="background-color: var(--color-terracotta-light);">
                <svg class="w-5 h-5" style="color: var(--color-terracotta-dark);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-sm" style="color: var(--color-espresso);">{tr.contact.info.emailLabel}</div>
                <a href={`mailto:${tr.contact.info.email}`} class="text-xs mt-0.5 transition-colors"
                   style="color: var(--color-terracotta);">
                  {tr.contact.info.email}
                </a>
              </div>
            </li>
            <li class="flex gap-4">
              <div class="w-10 h-10 rounded-full flex-shrink-0 flex items-center justify-center"
                   style="background-color: var(--color-terracotta-light);">
                <svg class="w-5 h-5" style="color: var(--color-terracotta-dark);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-sm" style="color: var(--color-espresso);">Phone / WhatsApp</div>
                <div class="text-xs opacity-60 mt-0.5">{tr.contact.info.phone}</div>
              </div>
            </li>
            <li class="flex gap-4">
              <div class="w-10 h-10 rounded-full flex-shrink-0 flex items-center justify-center"
                   style="background-color: var(--color-terracotta-light);">
                <svg class="w-5 h-5" style="color: var(--color-terracotta-dark);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 21l5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 016-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 01-3.827-5.802"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-sm" style="color: var(--color-espresso);">Languages</div>
                <div class="text-xs opacity-60 mt-0.5">{tr.contact.info.languages}</div>
              </div>
            </li>
          </ul>
        </div>

        <!-- GetYourGuide box -->
        <div class="p-6 rounded-sm text-white" style="background-color: var(--color-sage);">
          <h4 class="font-semibold mb-3" style="font-family: var(--font-display);">Book via GetYourGuide</h4>
          <p class="text-sm opacity-80 mb-4">Instant booking, flexible cancellation, available in your language.</p>
          <a
            href="https://www.getyourguide.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-white text-sm font-semibold px-4 py-2 rounded transition-opacity hover:opacity-90"
            style="color: var(--color-sage-dark);"
          >
            {tr.footer.bookVia}
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('success-msg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    try {
      await fetch('/', { method: 'POST', body: data });
      form.style.display = 'none';
      successMsg?.classList.remove('hidden');
    } catch {
      // fall through — Cloudflare Pages / Netlify will handle actual submission
      form.style.display = 'none';
      successMsg?.classList.remove('hidden');
    }
  });
</script>
