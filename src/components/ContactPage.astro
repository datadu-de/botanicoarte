---
import type { Locale, TranslationKeys } from '../i18n/translations';

interface Props { locale: Locale; tr: TranslationKeys; }
const { locale, tr } = Astro.props;
---

<!-- Page header -->
<div class="page-header">
  <div class="container">
    <span class="eyebrow">{tr.contact.subtitle}</span>
    <h1 class="page-title">{tr.contact.title}</h1>
    <p class="page-intro">{tr.contact.intro}</p>
  </div>
</div>

<section class="contact-section">
  <div class="container contact-inner">

    <!-- Form -->
    <div class="form-col">
      <form id="contact-form" name="contact" method="POST" novalidate>
        <input type="hidden" name="form-name" value="contact" />

        <div class="field-row">
          <div class="field">
            <label class="field-label" for="name">{tr.contact.nameLabel}</label>
            <input type="text" id="name" name="name" required class="field-input" autocomplete="name" />
          </div>
          <div class="field">
            <label class="field-label" for="email">{tr.contact.emailLabel}</label>
            <input type="email" id="email" name="email" required class="field-input" autocomplete="email" />
          </div>
        </div>

        <div class="field">
          <label class="field-label" for="subject">{tr.contact.subjectLabel}</label>
          <select id="subject" name="subject" class="field-input">
            <option value="general">{tr.contact.subjectOptions.general}</option>
            <option value="booking">{tr.contact.subjectOptions.booking}</option>
            <option value="private">{tr.contact.subjectOptions.private}</option>
            <option value="resident">{tr.contact.subjectOptions.resident}</option>
            <option value="other">{tr.contact.subjectOptions.other}</option>
          </select>
        </div>

        <div class="field">
          <label class="field-label" for="message">{tr.contact.messageLabel}</label>
          <textarea id="message" name="message" rows="7" required class="field-input field-textarea"></textarea>
        </div>

        <button type="submit" class="btn-primary submit-btn">{tr.contact.send}</button>
      </form>

      <div id="success-msg" class="success-msg" hidden>
        <h3 class="success-title">{tr.contact.successTitle}</h3>
        <p class="success-body">{tr.contact.successBody}</p>
      </div>
    </div>

    <!-- Info sidebar -->
    <aside class="info-col">
      <div class="info-block">
        <h2 class="info-heading">Arte <em>Botanico</em></h2>

        <ul class="info-list">
          <li class="info-item">
            <span class="info-label">{locale === 'de' ? 'Standort' : 'Location'}</span>
            <span class="info-value">{tr.contact.info.location}</span>
            <span class="info-sub">{tr.contact.info.locationDetail}</span>
          </li>
          <li class="info-item">
            <span class="info-label">{tr.contact.info.emailLabel}</span>
            <a href={`mailto:${tr.contact.info.email}`} class="info-link">{tr.contact.info.email}</a>
          </li>
          <li class="info-item">
            <span class="info-label">Phone / WhatsApp</span>
            <span class="info-value">{tr.contact.info.phone}</span>
          </li>
          <li class="info-item">
            <span class="info-label">{locale === 'de' ? 'Sprachen' : 'Languages'}</span>
            <span class="info-value">{tr.contact.info.languages}</span>
          </li>
        </ul>
      </div>

      <div class="gyg-box">
        <div class="gyg-label">
          <span class="gyg-line"></span>
          <span class="eyebrow">{locale === 'de' ? 'Buchungspartner' : 'Booking Partner'}</span>
        </div>
        <p class="gyg-text">
          {locale === 'de'
            ? 'Sofortbuchung, flexible Stornierung, in deiner Sprache.'
            : 'Instant booking, flexible cancellation, in your language.'}
        </p>
        <a
          href="https://www.getyourguide.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-link"
        >
          GetYourGuide ↗
        </a>
      </div>
    </aside>
  </div>
</section>

<style>
  .page-header {
    padding: 5rem 0 4rem;
    border-bottom: 1px solid var(--color-border);
  }
  .page-title {
    font-size: clamp(2.2rem, 4.5vw, 3.8rem);
    font-weight: 300;
    margin: 0.75rem 0 1rem;
    line-height: 1.1;
  }
  .page-intro {
    font-size: 0.88rem;
    line-height: 1.85;
    color: var(--color-muted);
    max-width: 56ch;
  }

  .contact-section { padding: 5rem 0 7rem; }
  .contact-inner {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 6rem;
    align-items: start;
  }

  /* Form */
  .field { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.5rem; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .field-label {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .field-input {
    width: 100%;
    padding: 0.75rem 0;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s;
    appearance: none;
    -webkit-appearance: none;
  }
  .field-input:focus { border-bottom-color: var(--color-ink); }
  .field-textarea { resize: vertical; min-height: 160px; }
  .submit-btn { margin-top: 1rem; cursor: pointer; }

  .success-msg {
    padding: 2.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
  }
  .success-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 300;
    margin-bottom: 0.6rem;
  }
  .success-body { font-size: 0.88rem; color: var(--color-muted); line-height: 1.75; }

  /* Info sidebar */
  .info-col { position: sticky; top: 88px; }

  .info-heading {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .info-heading em { color: var(--color-accent); font-style: italic; }

  .info-list { list-style: none; display: flex; flex-direction: column; gap: 1.5rem; }
  .info-item { display: flex; flex-direction: column; gap: 0.2rem; }
  .info-label {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .info-value { font-size: 0.88rem; color: var(--color-ink); }
  .info-sub { font-size: 0.78rem; color: var(--color-muted); }
  .info-link {
    font-size: 0.88rem;
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(168, 115, 95, 0.3);
    padding-bottom: 0.1rem;
    width: fit-content;
  }

  .gyg-box {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .gyg-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }
  .gyg-line { width: 20px; height: 1px; background: var(--color-accent); flex-shrink: 0; }
  .gyg-text {
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  @media (max-width: 768px) {
    .contact-inner { grid-template-columns: 1fr; gap: 3rem; }
    .field-row { grid-template-columns: 1fr; gap: 0; }
    .info-col { position: static; }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('success-msg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    try {
      await fetch('/', { method: 'POST', body: new FormData(form) });
    } catch {}
    form.hidden = true;
    if (successMsg) successMsg.hidden = false;
  });
</script>
