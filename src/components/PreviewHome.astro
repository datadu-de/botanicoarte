---
// Standalone English preview of the home page.
// All colours come from CSS custom properties defined by the parent page.

const courseKeys = ['acrylic','watercolor','resin','pottery','private','openStudio'] as const;

const courses = [
  { key:'acrylic',    audience:'Children & Adults', title:'Acrylic Painting',          desc:'Explore layering, texture and colour mixing in a vibrant, hands-on environment — suitable for all skill levels.' },
  { key:'watercolor', audience:'Children & Adults', title:'Watercolor / Aquarelle',     desc:'Discover wet-on-wet, gradients and botanical illustration guided by Mediterranean light and colour.' },
  { key:'resin',      audience:'Adults only',       title:'Resin Art Workshop',         desc:'Create jewellery, trays and wall art using epoxy resin. Colour mixing, mould techniques, no experience needed.' },
  { key:'pottery',    audience:'Adults only',       title:'Pottery Workshop',           desc:'Hand-building with clay — pinching, coiling, slab construction. Shape and personalise your own ceramic piece.' },
  { key:'private',    audience:'All ages',          title:'Private Classes at Home',    desc:'We come to you anywhere on Mallorca. Fully tailored sessions at your own pace, in your own space.' },
  { key:'openStudio', audience:'Residents',         title:'Open Studio for Residents',  desc:'Regular open studio sessions for long-term residents — paint together, experiment and connect.' },
];

const galleryImgs = [
  'https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?w=700&q=80',
  'https://images.unsplash.com/photo-1513364776144-60967b0f800f?w=700&q=80',
  'https://images.unsplash.com/photo-1565193566173-7a0ee3dbe261?w=700&q=80',
  'https://images.unsplash.com/photo-1460661419201-fd4cecdf8a8b?w=700&q=80',
];
---

<!-- NAV (inline, theme-aware) -->
<header class="pv-header">
  <div class="pv-container pv-header-inner">
    <a href="#" class="pv-logo">
      <div class="pv-logo-mark">AB</div>
      <div>
        <div class="pv-logo-name">Arte Botanico</div>
        <div class="pv-logo-sub">Mallorca</div>
      </div>
    </a>
    <nav class="pv-nav">
      <a href="#" class="pv-navlink">Home</a>
      <a href="#" class="pv-navlink">Courses</a>
      <a href="#" class="pv-navlink">Gallery</a>
      <a href="#" class="pv-navlink">Contact</a>
    </nav>
    <a href="#" class="pv-btn-primary pv-btn-sm">Book Now</a>
  </div>
</header>

<!-- HERO -->
<section class="pv-hero">
  <div class="pv-hero-img-wrap">
    <img src="https://images.unsplash.com/photo-1490730141103-6cac27aaab94?w=1600&q=80" alt="Studio" class="pv-hero-img" />
    <div class="pv-hero-overlay"></div>
  </div>
  <div class="pv-container pv-hero-content">
    <span class="pv-badge">Art Studio · Mallorca</span>
    <h1 class="pv-hero-headline">Discover Your Creative Side in Paradise</h1>
    <p class="pv-hero-sub">Painting classes, resin workshops &amp; pottery in the heart of Mallorca — for curious beginners and seasoned artists alike.</p>
    <div class="pv-hero-actions">
      <a href="#" class="pv-btn-primary">Explore Courses</a>
      <a href="#" class="pv-btn-ghost">Book via GetYourGuide ↗</a>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section class="pv-section">
  <div class="pv-container pv-about">
    <div class="pv-about-text">
      <span class="pv-eyebrow">Welcome to Arte Botanico</span>
      <h2 class="pv-section-title">Where Art Meets the Soul of Mallorca</h2>
      <p class="pv-body">Arte Botanico is a warm, welcoming atelier nestled on the beautiful island of Mallorca. Our studio offers a sanctuary where creativity flourishes — surrounded by Mediterranean light, botanical gardens, and the tranquil pace of island life.</p>
      <p class="pv-body" style="margin-top:1rem;">Whether you're picking up a brush for the very first time or deepening a lifelong practice, our small-group classes ensure personal attention and the joy of making something beautiful.</p>
      <div class="pv-stats">
        <div class="pv-stat"><span class="pv-stat-val">6+</span><span class="pv-stat-lbl">Course types</span></div>
        <div class="pv-stat"><span class="pv-stat-val">6</span><span class="pv-stat-lbl">Languages</span></div>
        <div class="pv-stat"><span class="pv-stat-val">∞</span><span class="pv-stat-lbl">Creativity</span></div>
      </div>
    </div>
    <div class="pv-about-img-wrap">
      <img src="https://images.unsplash.com/photo-1547826039-bfc35e0f1ea8?w=800&q=80" alt="Artist" class="pv-about-img" />
      <div class="pv-about-deco pv-about-deco-1"></div>
      <div class="pv-about-deco pv-about-deco-2"></div>
    </div>
  </div>
</section>

<!-- COURSES -->
<section class="pv-section pv-bg-alt">
  <div class="pv-container">
    <div class="pv-section-header">
      <span class="pv-eyebrow">What We Offer</span>
      <h2 class="pv-section-title">Courses &amp; Workshops</h2>
      <p class="pv-body" style="max-width:36rem;margin:0 auto;">From first brushstrokes to finished masterpieces — find the right course for you.</p>
    </div>
    <div class="pv-course-grid">
      {courses.map(c => (
        <div class="pv-course-card">
          <div class="pv-course-icon"></div>
          <span class="pv-course-audience">{c.audience}</span>
          <h3 class="pv-course-title">{c.title}</h3>
          <p class="pv-course-desc">{c.desc}</p>
          <a href="#" class="pv-link">Learn More →</a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- GYG BANNER -->
<section class="pv-gyg">
  <div class="pv-container pv-gyg-inner">
    <span class="pv-gyg-badge">Booking Partner</span>
    <h2 class="pv-gyg-title">Book Your Experience on GetYourGuide</h2>
    <p class="pv-gyg-body">Instant booking, flexible cancellation, available in your language.</p>
    <a href="#" class="pv-btn-white">Find Us on GetYourGuide ↗</a>
  </div>
</section>

<!-- GALLERY TEASER -->
<section class="pv-section">
  <div class="pv-container">
    <div class="pv-gallery-header">
      <div>
        <span class="pv-eyebrow">Our Work</span>
        <h2 class="pv-section-title">A Glimpse Into the Studio</h2>
      </div>
      <a href="#" class="pv-btn-outline">Gallery</a>
    </div>
    <div class="pv-gallery-grid">
      {galleryImgs.map((src, i) => (
        <div class={`pv-gallery-item ${i === 0 ? 'pv-gallery-featured' : ''}`}>
          <img src={src} alt="Gallery" class="pv-gallery-img" loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
/* ─── Layout helpers ────────────────────────────────────── */
.pv-container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
.pv-section   { padding: 5rem 0; }
.pv-bg-alt    { background-color: var(--pv-bg-alt); }

/* ─── Header ────────────────────────────────────────────── */
.pv-header {
  position: sticky; top: 52px; z-index: 90;
  background-color: var(--pv-header-bg);
  border-bottom: 1px solid var(--pv-border);
  backdrop-filter: blur(8px);
}
.pv-header-inner {
  display: flex; align-items: center; justify-content: space-between;
  height: 4rem;
}
.pv-logo { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; }
.pv-logo-mark {
  width: 2.25rem; height: 2.25rem; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background-color: var(--pv-accent);
  color: var(--pv-accent-text);
  font-family: var(--pv-font-display);
  font-weight: 700; font-size: 0.8rem;
}
.pv-logo-name { font-family: var(--pv-font-display); font-size: 1rem; font-weight: 600; color: var(--pv-heading); line-height: 1.1; }
.pv-logo-sub  { font-size: 0.6rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--pv-accent); line-height: 1.1; }
.pv-nav { display: flex; gap: 1.75rem; }
.pv-navlink { font-size: 0.85rem; font-weight: 500; color: var(--pv-body-color); text-decoration: none; }
.pv-navlink:hover { color: var(--pv-accent); }

/* ─── Buttons ───────────────────────────────────────────── */
.pv-btn-primary {
  display: inline-block; background-color: var(--pv-accent); color: var(--pv-accent-text);
  padding: 0.7rem 1.75rem; border-radius: var(--pv-radius); font-weight: 600;
  font-size: 0.85rem; letter-spacing: 0.04em; text-transform: uppercase;
  text-decoration: none; transition: opacity 0.2s;
}
.pv-btn-primary:hover { opacity: 0.88; }
.pv-btn-sm { padding: 0.45rem 1.1rem; }
.pv-btn-outline {
  display: inline-block; border: 2px solid var(--pv-accent); color: var(--pv-accent);
  padding: 0.65rem 1.5rem; border-radius: var(--pv-radius); font-weight: 600;
  font-size: 0.8rem; letter-spacing: 0.05em; text-transform: uppercase;
  text-decoration: none; transition: all 0.2s;
}
.pv-btn-outline:hover { background-color: var(--pv-accent); color: var(--pv-accent-text); }
.pv-btn-ghost {
  display: inline-flex; align-items: center; gap: 0.4rem;
  border: 1.5px solid rgba(255,255,255,0.45); color: white;
  padding: 0.7rem 1.5rem; border-radius: var(--pv-radius); font-weight: 600;
  font-size: 0.85rem; text-decoration: none; transition: background 0.2s;
}
.pv-btn-ghost:hover { background: rgba(255,255,255,0.1); }
.pv-btn-white {
  display: inline-block; background: white; color: var(--pv-gyg-color);
  padding: 0.85rem 2.25rem; border-radius: var(--pv-radius); font-weight: 700;
  font-size: 0.875rem; letter-spacing: 0.05em; text-transform: uppercase;
  text-decoration: none; transition: opacity 0.2s;
}
.pv-btn-white:hover { opacity: 0.9; }

/* ─── Hero ──────────────────────────────────────────────── */
.pv-hero { position: relative; min-height: 90vh; display: flex; align-items: center; overflow: hidden; }
.pv-hero-img-wrap { position: absolute; inset: 0; }
.pv-hero-img  { width: 100%; height: 100%; object-fit: cover; }
.pv-hero-overlay {
  position: absolute; inset: 0;
  background: var(--pv-hero-overlay);
}
.pv-hero-content { position: relative; z-index: 1; padding-top: 5rem; padding-bottom: 5rem; max-width: 680px; }
.pv-badge {
  display: inline-block; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.18em;
  text-transform: uppercase; padding: 0.4rem 0.9rem; border-radius: 99px; margin-bottom: 1.5rem;
  background: var(--pv-badge-bg); color: var(--pv-badge-color); border: 1px solid var(--pv-badge-border);
}
.pv-hero-headline {
  font-family: var(--pv-font-display); font-size: clamp(2.2rem,5.5vw,3.75rem); font-weight: 600;
  line-height: 1.15; color: white; margin-bottom: 1.25rem;
}
.pv-hero-sub  { font-size: 1.1rem; line-height: 1.65; color: rgba(255,255,255,0.82); margin-bottom: 2.25rem; }
.pv-hero-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; }

/* ─── About ─────────────────────────────────────────────── */
.pv-about { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
.pv-eyebrow { display: block; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--pv-accent); margin-bottom: 0.9rem; }
.pv-section-title { font-family: var(--pv-font-display); font-size: clamp(1.6rem,3.5vw,2.4rem); font-weight: 600; color: var(--pv-heading); line-height: 1.2; margin-bottom: 1.25rem; }
.pv-body { font-size: 0.95rem; line-height: 1.8; color: var(--pv-body-color); opacity: 0.8; }
.pv-stats { display: flex; gap: 2.5rem; margin-top: 2rem; }
.pv-stat { display: flex; flex-direction: column; }
.pv-stat-val { font-family: var(--pv-font-display); font-size: 2rem; font-weight: 700; color: var(--pv-accent); line-height: 1; }
.pv-stat-lbl { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.55; margin-top: 0.25rem; }
.pv-about-img-wrap { position: relative; }
.pv-about-img { width: 100%; aspect-ratio: 4/5; object-fit: cover; border-radius: var(--pv-radius); }
.pv-about-deco { position: absolute; border-radius: var(--pv-radius); z-index: -1; }
.pv-about-deco-1 { bottom: -1rem; left: -1rem; width: 8rem; height: 8rem; background-color: var(--pv-deco-1); opacity: 0.3; }
.pv-about-deco-2 { top: -1rem; right: -1rem; width: 6rem; height: 6rem; background-color: var(--pv-deco-2); opacity: 0.25; }

/* ─── Courses ───────────────────────────────────────────── */
.pv-section-header { text-align: center; margin-bottom: 3.5rem; }
.pv-course-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.5rem; }
.pv-course-card {
  background: var(--pv-card-bg); border: 1px solid var(--pv-border);
  border-radius: var(--pv-card-radius); padding: 2rem;
  transition: transform 0.2s;
}
.pv-course-card:hover { transform: translateY(-3px); }
.pv-course-icon {
  width: 3rem; height: 3rem; border-radius: 50%; margin-bottom: 1.1rem;
  background-color: var(--pv-icon-bg);
}
.pv-course-audience { display: block; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--pv-green); margin-bottom: 0.5rem; }
.pv-course-title { font-family: var(--pv-font-display); font-size: 1.15rem; font-weight: 600; color: var(--pv-heading); margin-bottom: 0.75rem; }
.pv-course-desc { font-size: 0.875rem; line-height: 1.7; color: var(--pv-body-color); opacity: 0.75; margin-bottom: 1.25rem; }
.pv-link { font-size: 0.8rem; font-weight: 700; color: var(--pv-accent); text-decoration: none; }
.pv-link:hover { opacity: 0.75; }

/* ─── GYG banner ────────────────────────────────────────── */
.pv-gyg { background: var(--pv-gyg-bg); padding: 5rem 0; }
.pv-gyg-inner { text-align: center; }
.pv-gyg-badge {
  display: inline-block; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.15em;
  text-transform: uppercase; padding: 0.35rem 0.8rem; border-radius: 99px; margin-bottom: 1.25rem;
  background: rgba(255,255,255,0.15); color: rgba(255,255,255,0.85);
}
.pv-gyg-title { font-family: var(--pv-font-display); font-size: clamp(1.5rem,3vw,2.2rem); color: white; font-weight: 600; margin-bottom: 0.9rem; }
.pv-gyg-body  { font-size: 1rem; color: rgba(255,255,255,0.78); margin-bottom: 2rem; }

/* ─── Gallery ───────────────────────────────────────────── */
.pv-gallery-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 1.5rem; }
.pv-gallery-grid { display: grid; grid-template-columns: repeat(4,1fr); grid-template-rows: auto auto; gap: 0.75rem; }
.pv-gallery-item { overflow: hidden; border-radius: var(--pv-radius); }
.pv-gallery-featured { grid-column: span 2; grid-row: span 2; }
.pv-gallery-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
.pv-gallery-item:hover .pv-gallery-img { transform: scale(1.04); }
</style>
