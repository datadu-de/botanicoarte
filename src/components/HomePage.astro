---
import type { Locale, TranslationKeys } from '../i18n/translations';

interface Props { locale: Locale; tr: TranslationKeys; }
const { locale, tr } = Astro.props;

type CourseKey = 'acrylic' | 'watercolor' | 'resin' | 'pottery' | 'private' | 'openStudio';
const courseKeys: CourseKey[] = ['acrylic','watercolor','resin','pottery','private','openStudio'];

const galleryImages = [
  { src: 'https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?w=800&q=80', alt: 'Watercolor paints' },
  { src: 'https://images.unsplash.com/photo-1513364776144-60967b0f800f?w=800&q=80', alt: 'Painting in progress' },
  { src: 'https://images.unsplash.com/photo-1565193566173-7a0ee3dbe261?w=800&q=80', alt: 'Pottery' },
  { src: 'https://images.unsplash.com/photo-1460661419201-fd4cecdf8a8b?w=800&q=80', alt: 'Art supplies' },
];
---

<!-- ────────────────── HERO ────────────────── -->
<section class="hero">
  <div class="hero-text">
    <div class="hero-kicker hero-enter" style="--enter-delay:0.05s">
      <span class="kicker-line"></span>
      <span class="eyebrow">Art Studio · Mallorca</span>
    </div>
    <h1 class="hero-headline hero-enter" style="--enter-delay:0.18s">
      {tr.hero.headline.split(' ').slice(0,2).join(' ')}<br>
      <em>{tr.hero.headline.split(' ').slice(2,4).join(' ')}</em><br>
      {tr.hero.headline.split(' ').slice(4).join(' ')}
    </h1>
    <p class="hero-sub hero-enter" style="--enter-delay:0.35s">{tr.hero.subheadline}</p>
    <div class="hero-actions hero-enter" style="--enter-delay:0.5s">
      <a href={`/${locale}/courses/`} class="btn-primary">{tr.hero.cta}</a>
      <a href="https://www.getyourguide.com" target="_blank" rel="noopener noreferrer" class="btn-outline">
        {tr.hero.ctaSecondary}
      </a>
    </div>
  </div>
  <div class="hero-image">
    <img
      src="https://images.unsplash.com/photo-1490730141103-6cac27aaab94?w=1200&q=85"
      alt="Art studio Mallorca"
      class="hero-img"
      id="hero-parallax"
    />
    <span class="hero-caption">Arte Botanico · Mallorca</span>
  </div>
</section>

<!-- ────────────────── ABOUT ────────────────── -->
<section class="about section">
  <div class="container about-inner">
    <div class="about-sidebar" data-reveal>
      <span class="eyebrow">{tr.about.subtitle}</span>
      <div class="about-big-number">01</div>
      <div class="about-stats">
        <div class="stat">
          <span class="stat-val">{tr.about.stat1Value}</span>
          <span class="stat-lbl">{tr.about.stat1Label}</span>
        </div>
        <div class="stat">
          <span class="stat-val">{tr.about.stat2Value}</span>
          <span class="stat-lbl">{tr.about.stat2Label}</span>
        </div>
        <div class="stat">
          <span class="stat-val">{tr.about.stat3Value}</span>
          <span class="stat-lbl">{tr.about.stat3Label}</span>
        </div>
      </div>
    </div>
    <div class="about-content" data-reveal data-delay="1">
      <img
        src="https://images.unsplash.com/photo-1547826039-bfc35e0f1ea8?w=900&q=80"
        alt="Artist at work"
        class="about-img"
      />
      <div class="about-text">
        <h2 class="about-title">{tr.about.title}</h2>
        <p class="body-text">{tr.about.body}</p>
        <p class="body-text" style="margin-top:1.1rem;">{tr.about.body2}</p>
        <a href={`/${locale}/courses/`} class="text-link" style="display:inline-block;margin-top:2rem;">{tr.courses.allCourses}</a>
      </div>
    </div>
  </div>
</section>

<!-- ────────────────── COURSES ────────────────── -->
<section class="courses section-alt">
  <div class="container">
    <div class="courses-header" data-reveal>
      <div>
        <span class="eyebrow" style="margin-bottom:.75rem;">{tr.courses.subtitle}</span>
        <h2 class="section-title">{tr.courses.title}</h2>
      </div>
      <a href={`/${locale}/courses/`} class="btn-outline">{tr.courses.allCourses}</a>
    </div>
    <div class="course-grid">
      {courseKeys.map((key, i) => {
        const c = tr.courses.items[key];
        const num = String(i + 1).padStart(2, '0');
        return (
          <div class="course-item" data-reveal data-delay={String(i)}>
            <div class="course-num">{num}</div>
            <span class="course-audience">{c.audience}</span>
            <h3 class="course-title">{c.title}</h3>
            <p class="course-desc">{c.description}</p>
            <a href={`/${locale}/courses/`} class="text-link">{tr.courses.learnMore}</a>
          </div>
        );
      })}
    </div>
  </div>
</section>

<!-- ────────────────── GYG ────────────────── -->
<section class="gyg section">
  <div class="container gyg-inner">
    <div class="gyg-text" data-reveal>
      <div class="gyg-label">
        <span class="gyg-label-line"></span>
        <span class="eyebrow">{tr.getyourguide.badge}</span>
      </div>
      <h2 class="gyg-title">{tr.getyourguide.title}</h2>
      <p class="body-text gyg-body">{tr.getyourguide.body}</p>
      <a href="https://www.getyourguide.com" target="_blank" rel="noopener noreferrer" class="btn-primary">
        {tr.getyourguide.cta} ↗
      </a>
    </div>
    <div class="gyg-image" data-reveal data-delay="1">
      <img
        src="https://images.unsplash.com/photo-1460661419201-fd4cecdf8a8b?w=800&q=80"
        alt="Art supplies"
        class="gyg-img"
      />
    </div>
  </div>
</section>

<!-- ────────────────── GALLERY TEASER ────────────────── -->
<section class="gallery-teaser section-alt">
  <div class="container">
    <div class="gallery-header" data-reveal>
      <div>
        <span class="eyebrow" style="margin-bottom:.6rem;">{tr.gallery.subtitle}</span>
        <h2 class="section-title">{tr.gallery.title}</h2>
      </div>
      <a href={`/${locale}/gallery/`} class="btn-outline">{tr.nav.gallery}</a>
    </div>
    <div class="gallery-grid">
      {galleryImages.map((img, i) => (
        <div class={`gallery-item${i === 0 ? ' gallery-featured' : ''}`} data-reveal data-delay={String(i)}>
          <img src={img.src} alt={img.alt} class="gallery-img" loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Hero entrance animations ─────────────────── */
  .hero-enter {
    opacity: 0;
    transform: translateY(22px);
    animation: heroEnter 0.85s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--enter-delay, 0s);
  }
  @keyframes heroEnter {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── Scroll reveal ────────────────────────────── */
  [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  /* Stagger delays for siblings with data-delay */
  [data-delay="1"] { transition-delay: 0.08s; }
  [data-delay="2"] { transition-delay: 0.16s; }
  [data-delay="3"] { transition-delay: 0.24s; }
  [data-delay="4"] { transition-delay: 0.32s; }
  [data-delay="5"] { transition-delay: 0.40s; }

  /* ── Hero ──────────────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: calc(100vh - 68px);
    border-bottom: 1px solid var(--color-border);
  }
  .hero-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5rem 4rem 5rem 2rem;
    border-right: 1px solid var(--color-border);
  }
  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .kicker-line {
    flex-shrink: 0;
    width: 40px;
    height: 1px;
    background: var(--color-accent);
  }
  .hero-headline {
    font-size: clamp(2.8rem, 5.5vw, 4.8rem);
    font-weight: 300;
    line-height: 1.06;
    margin-bottom: 1.75rem;
  }
  .hero-headline em { color: var(--color-accent); font-style: italic; }
  .hero-sub {
    font-size: 0.9rem;
    line-height: 1.85;
    color: var(--color-muted);
    max-width: 44ch;
    margin-bottom: 2.75rem;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  .hero-image {
    position: relative;
    overflow: hidden;
  }
  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Slightly oversized to leave room for parallax travel */
    transform: scale(1.12);
    transform-origin: center top;
    will-change: transform;
  }
  .hero-caption {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    z-index: 1;
  }

  /* ── About ─────────────────────────────────────── */
  .about { border-top: 1px solid var(--color-border); }
  .about-inner {
    display: grid;
    grid-template-columns: 1fr 2.5fr;
    gap: 5rem;
    align-items: start;
  }
  .about-sidebar { position: sticky; top: 88px; }
  .about-big-number {
    font-family: var(--font-display);
    font-size: 7rem;
    font-weight: 300;
    color: var(--color-border);
    line-height: 1;
    letter-spacing: -0.04em;
    margin-top: 1rem;
  }
  .about-stats {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .stat-val {
    display: block;
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 300;
    color: var(--color-accent);
    line-height: 1;
  }
  .stat-lbl {
    display: block;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-top: 0.2rem;
  }
  .about-img {
    width: 100%;
    aspect-ratio: 3/2;
    object-fit: cover;
    display: block;
    margin-bottom: 2.5rem;
  }
  .about-title {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 300;
    margin-bottom: 1.25rem;
  }
  .body-text {
    font-size: 0.88rem;
    line-height: 1.9;
    color: var(--color-muted);
  }

  /* ── Courses ───────────────────────────────────── */
  .courses-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 300;
    color: var(--color-ink);
    line-height: 1.1;
  }
  .course-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-left: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border);
  }
  .course-item {
    padding: 2.5rem 2rem;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    transition: background 0.3s ease,
                opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .course-item:hover { background: var(--color-bg); }
  .course-num {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-style: italic;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }
  .course-audience {
    display: block;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }
  .course-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--color-ink);
    margin-bottom: 0.65rem;
    line-height: 1.2;
  }
  .course-desc {
    font-size: 0.82rem;
    line-height: 1.75;
    color: var(--color-muted);
    margin-bottom: 1.5rem;
  }

  /* ── GYG ────────────────────────────────────────── */
  .gyg-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
  }
  .gyg-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .gyg-label-line {
    width: 24px;
    height: 1px;
    background: var(--color-accent);
    flex-shrink: 0;
  }
  .gyg-title {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 300;
    margin-bottom: 1.25rem;
    line-height: 1.15;
  }
  .gyg-body { margin-bottom: 2.25rem; max-width: 46ch; }
  .gyg-img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
  }

  /* ── Gallery teaser ─────────────────────────────── */
  .gallery-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: 240px 240px;
    gap: 3px;
  }
  .gallery-item { overflow: hidden; }
  .gallery-featured { grid-column: span 2; grid-row: span 2; }
  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .gallery-item:hover .gallery-img { transform: scale(1.05); }

  /* ── Responsive ─────────────────────────────────── */
  @media (max-width: 1024px) {
    .hero { grid-template-columns: 1fr; min-height: auto; }
    .hero-text { border-right: none; border-bottom: 1px solid var(--color-border); padding: 4rem 2rem; }
    .hero-image { min-height: 55vw; }
    .about-inner { grid-template-columns: 1fr; gap: 2rem; }
    .about-sidebar { position: static; display: flex; gap: 2rem; align-items: flex-start; flex-wrap: wrap; }
    .about-big-number { display: none; }
    .about-stats { flex-direction: row; gap: 2rem; margin-top: 0; }
    .gyg-inner { grid-template-columns: 1fr; gap: 3rem; }
  }
  @media (max-width: 768px) {
    .course-grid { grid-template-columns: 1fr 1fr; }
    .courses-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .gallery-grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
    .gallery-featured { grid-column: span 2; grid-row: span 1; }
    .gallery-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
  }
  @media (max-width: 480px) {
    .course-grid { grid-template-columns: 1fr; }
    .hero-text { padding: 3rem 1.5rem; }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-enter,
    [data-reveal] {
      animation: none;
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // ── Parallax: hero right-panel image ──────────────────────────────
  const heroParallax = document.getElementById('hero-parallax') as HTMLImageElement | null;
  if (heroParallax) {
    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const y = window.scrollY * 0.28;
          heroParallax.style.transform = `scale(1.12) translateY(${y}px)`;
          ticking = false;
        });
        ticking = true;
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // ── Scroll reveal: IntersectionObserver ──────────────────────────
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );

  document.querySelectorAll('[data-reveal]').forEach(el => revealObserver.observe(el));
</script>
