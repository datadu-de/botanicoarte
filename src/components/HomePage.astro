---
import type { Locale, TranslationKeys } from '../i18n/translations';

interface Props {
  locale: Locale;
  tr: TranslationKeys;
}

const { locale, tr } = Astro.props;

const courseIcons: Record<string, string> = {
  acrylic: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42"/></svg>`,
  watercolor: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/></svg>`,
  resin: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5"/></svg>`,
  pottery: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/></svg>`,
  private: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>`,
  openStudio: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/></svg>`,
};

const courseKeys = ['acrylic', 'watercolor', 'resin', 'pottery', 'private', 'openStudio'] as const;
type CourseKey = typeof courseKeys[number];

// Unsplash images (themed)
const galleryImages = [
  { src: 'https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?w=600&q=80', alt: 'Watercolor paints' },
  { src: 'https://images.unsplash.com/photo-1513364776144-60967b0f800f?w=600&q=80', alt: 'Painting in progress' },
  { src: 'https://images.unsplash.com/photo-1565193566173-7a0ee3dbe261?w=600&q=80', alt: 'Pottery workshop' },
  { src: 'https://images.unsplash.com/photo-1460661419201-fd4cecdf8a8b?w=600&q=80', alt: 'Art supplies' },
];
---

<!-- HERO -->
<section class="relative min-h-screen flex items-center overflow-hidden">
  <div class="absolute inset-0">
    <img
      src="https://images.unsplash.com/photo-1578926288207-a90a0fd46e64?w=1600&q=80"
      alt="Art studio Mallorca"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(45,32,22,0.72) 0%, rgba(45,32,22,0.4) 60%, rgba(193,122,90,0.2) 100%);"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <div class="max-w-2xl">
      <span class="inline-block text-xs font-bold tracking-widest uppercase mb-6 px-3 py-1.5 rounded-full"
            style="background-color: rgba(193,122,90,0.25); color: var(--color-terracotta-light); border: 1px solid rgba(193,122,90,0.4);">
        {tr.hero.badge}
      </span>
      <h1 class="text-white mb-6" style="font-family: var(--font-display); font-size: clamp(2.5rem, 6vw, 4rem); line-height: 1.15; font-weight: 600;">
        {tr.hero.headline}
      </h1>
      <p class="text-lg mb-10 leading-relaxed max-w-xl" style="color: rgba(247,240,230,0.85);">
        {tr.hero.subheadline}
      </p>
      <div class="flex flex-wrap gap-4">
        <a href={`/${locale}/courses/`} class="btn-primary">
          {tr.hero.cta}
        </a>
        <a
          href="https://www.getyourguide.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 font-semibold text-sm tracking-wide px-6 py-3 rounded border-2 transition-all duration-200"
          style="color: white; border-color: rgba(255,255,255,0.5);"
          onmouseover="this.style.backgroundColor='rgba(255,255,255,0.1)'"
          onmouseout="this.style.backgroundColor='transparent'"
        >
          {tr.hero.ctaSecondary}
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50">
    <div class="w-px h-12 animate-pulse" style="background: linear-gradient(to bottom, transparent, white);"></div>
  </div>
</section>

<!-- ABOUT -->
<section class="py-24 lg:py-32">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <span class="section-subtitle block mb-4">{tr.about.subtitle}</span>
        <h2 class="section-title mb-6">{tr.about.title}</h2>
        <p class="leading-relaxed mb-4 opacity-80">{tr.about.body}</p>
        <p class="leading-relaxed mb-10 opacity-80">{tr.about.body2}</p>
        <div class="flex gap-12">
          <div>
            <div class="text-3xl font-bold mb-1" style="font-family: var(--font-display); color: var(--color-terracotta);">{tr.about.stat1Value}</div>
            <div class="text-xs tracking-widest uppercase opacity-60">{tr.about.stat1Label}</div>
          </div>
          <div>
            <div class="text-3xl font-bold mb-1" style="font-family: var(--font-display); color: var(--color-terracotta);">{tr.about.stat2Value}</div>
            <div class="text-xs tracking-widest uppercase opacity-60">{tr.about.stat2Label}</div>
          </div>
          <div>
            <div class="text-3xl font-bold mb-1" style="font-family: var(--font-display); color: var(--color-terracotta);">{tr.about.stat3Value}</div>
            <div class="text-xs tracking-widest uppercase opacity-60">{tr.about.stat3Label}</div>
          </div>
        </div>
      </div>
      <div class="relative">
        <div class="aspect-[4/5] rounded-sm overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1541961017811-14f2d1d2de97?w=800&q=80"
            alt="Artist painting in the studio"
            class="w-full h-full object-cover"
          />
        </div>
        <!-- Decorative accent -->
        <div class="absolute -bottom-4 -left-4 w-32 h-32 rounded-sm -z-10"
             style="background-color: var(--color-terracotta-light); opacity: 0.3;"></div>
        <div class="absolute -top-4 -right-4 w-24 h-24 rounded-sm -z-10"
             style="background-color: var(--color-sage-light); opacity: 0.3;"></div>
      </div>
    </div>
  </div>
</section>

<!-- COURSES OVERVIEW -->
<section class="py-24" style="background-color: var(--color-blush);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="section-subtitle block mb-4">{tr.courses.subtitle}</span>
      <h2 class="section-title mb-4">{tr.courses.title}</h2>
      <p class="opacity-70 max-w-xl mx-auto">{tr.courses.intro}</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {courseKeys.map((key: CourseKey) => {
        const course = tr.courses.items[key];
        return (
          <div class="rounded-sm p-8 flex flex-col group hover:-translate-y-1 transition-transform duration-200"
               style="background-color: var(--color-sand);">
            <div class="mb-5 w-14 h-14 rounded-full flex items-center justify-center"
                 style="background-color: var(--color-terracotta-light); color: var(--color-terracotta-dark); opacity: 0.9;">
              <Fragment set:html={courseIcons[key]} />
            </div>
            <div class="text-xs font-bold tracking-widest uppercase mb-2" style="color: var(--color-sage);">
              {course.audience}
            </div>
            <h3 class="text-xl mb-3" style="font-family: var(--font-display); color: var(--color-espresso);">{course.title}</h3>
            <p class="text-sm leading-relaxed opacity-70 mb-6 flex-1">{course.description}</p>
            <a href={`/${locale}/courses/`} class="text-sm font-semibold tracking-wide flex items-center gap-1 group-hover:gap-2 transition-all"
               style="color: var(--color-terracotta);">
              {tr.courses.learnMore}
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
              </svg>
            </a>
          </div>
        );
      })}
    </div>
    <div class="text-center mt-12">
      <a href={`/${locale}/courses/`} class="btn-primary">{tr.courses.allCourses}</a>
    </div>
  </div>
</section>

<!-- GETYOURGUIDE CTA -->
<section class="py-20" style="background-color: var(--color-sage);">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <span class="inline-block text-xs font-bold tracking-widest uppercase mb-4 px-3 py-1.5 rounded-full"
          style="background-color: rgba(255,255,255,0.15); color: rgba(255,255,255,0.9);">
      {tr.getyourguide.badge}
    </span>
    <h2 class="text-3xl md:text-4xl font-semibold text-white mb-6" style="font-family: var(--font-display);">
      {tr.getyourguide.title}
    </h2>
    <p class="text-lg mb-10 max-w-2xl mx-auto" style="color: rgba(255,255,255,0.8);">
      {tr.getyourguide.body}
    </p>
    <a
      href="https://www.getyourguide.com"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-3 bg-white font-semibold text-sm tracking-wide uppercase px-8 py-4 rounded transition-opacity duration-200 hover:opacity-90"
      style="color: var(--color-sage-dark);"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/>
      </svg>
      {tr.getyourguide.cta}
    </a>
  </div>
</section>

<!-- GALLERY TEASER -->
<section class="py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-6 mb-12">
      <div>
        <span class="section-subtitle block mb-3">{tr.gallery.subtitle}</span>
        <h2 class="section-title">{tr.gallery.title}</h2>
      </div>
      <a href={`/${locale}/gallery/`} class="btn-outline whitespace-nowrap">
        {tr.nav.gallery}
      </a>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
      {galleryImages.map((img, i) => (
        <div class={`aspect-square overflow-hidden rounded-sm ${i === 0 ? 'lg:col-span-2 lg:row-span-2 aspect-auto lg:aspect-auto' : ''}`}>
          <img
            src={img.src}
            alt={img.alt}
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>
</section>
