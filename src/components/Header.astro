---
import type { Locale } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props {
  locale: Locale;
  currentPath?: string;
}

const { locale, currentPath = '/' } = Astro.props;
const tr = t(locale);
const altLocale = locale === 'en' ? 'de' : 'en';
const altHref   = `/${altLocale}${currentPath === '/' ? '/' : currentPath}`;

const nav = [
  { href: `/${locale}/`,          label: tr.nav.home },
  { href: `/${locale}/courses/`,  label: tr.nav.courses },
  { href: `/${locale}/gallery/`,  label: tr.nav.gallery },
  { href: `/${locale}/contact/`,  label: tr.nav.contact },
];
---

<header id="site-header">
  <div class="container header-inner">

    <!-- Logo -->
    <a href={`/${locale}/`} class="logo" aria-label="Arte Botanico home">
      Arte <em>Botanico</em>
    </a>

    <!-- Desktop nav -->
    <nav class="site-nav" aria-label="Main navigation">
      {nav.map(link => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </nav>

    <!-- Right controls -->
    <div class="header-right">
      <a href={altHref} class="lang-switch" aria-label={`Switch to ${altLocale.toUpperCase()}`}>
        {altLocale.toUpperCase()}
      </a>
      <a href={`/${locale}/contact/`} class="header-cta">
        {tr.nav.bookNow}
      </a>
      <button id="mobile-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span class="burger"></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" aria-hidden="true">
    <div class="container mobile-inner">
      {nav.map(link => (
        <a href={link.href} class="mobile-link">{link.label}</a>
      ))}
      <div class="mobile-footer">
        <a href={altHref} class="lang-switch">{altLocale.toUpperCase()}</a>
        <a href={`/${locale}/contact/`} class="btn-primary">{tr.nav.bookNow}</a>
      </div>
    </div>
  </div>
</header>

<!-- Push content below fixed header -->
<div style="height: var(--header-h, 68px);"></div>

<style>
  #site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 200;
    background: rgba(249, 248, 245, 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
    --header-h: 68px;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: var(--color-ink);
    text-decoration: none;
  }
  .logo em { color: var(--color-accent); font-style: italic; }

  .site-nav {
    display: flex;
    gap: 2.5rem;
  }
  .nav-link {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .nav-link:hover { color: var(--color-ink); }

  .header-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .lang-switch {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(168, 115, 95, 0.35);
    padding-bottom: 0.1rem;
  }

  .header-cta {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.1rem;
    transition: border-color 0.2s;
  }
  .header-cta:hover { border-color: var(--color-ink); }

  /* Mobile toggle */
  #mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .burger {
    display: block;
    width: 22px;
    height: 1px;
    background: var(--color-ink);
    position: relative;
  }
  .burger::before, .burger::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 1px;
    background: var(--color-ink);
    left: 0;
    transition: transform 0.2s;
  }
  .burger::before { top: -6px; }
  .burger::after  { top:  6px; }

  /* Mobile menu */
  #mobile-menu {
    display: none;
    border-top: 1px solid var(--color-border);
  }
  .mobile-inner {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 1rem 2rem;
  }
  .mobile-link {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-link:hover { color: var(--color-ink); }
  .mobile-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
  }

  @media (max-width: 768px) {
    .site-nav, .header-cta { display: none; }
    #mobile-toggle { display: block; }
  }

  @media (min-width: 769px) {
    #mobile-menu { display: none !important; }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const menu   = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.style.display === 'block';
    if (menu) menu.style.display = open ? 'none' : 'block';
    toggle.setAttribute('aria-expanded', String(!open));
  });
</script>
