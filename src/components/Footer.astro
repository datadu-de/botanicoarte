---
import type { Locale } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const year = new Date().getFullYear();
---

<footer style="background-color: var(--color-espresso); color: var(--color-blush);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-full flex items-center justify-center"
               style="background-color: var(--color-terracotta);">
            <span class="text-white font-bold text-sm" style="font-family: var(--font-display)">AB</span>
          </div>
          <div>
            <div class="font-semibold text-lg text-white" style="font-family: var(--font-display);">Arte Botanico</div>
            <div class="text-xs tracking-widest uppercase" style="color: var(--color-terracotta-light);">Mallorca</div>
          </div>
        </div>
        <p class="text-sm leading-relaxed opacity-70 max-w-xs">{tr.footer.tagline}</p>
        <a
          href="https://www.getyourguide.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 mt-4 text-xs font-semibold tracking-wide uppercase px-4 py-2 rounded border transition-colors duration-200"
          style="border-color: var(--color-terracotta); color: var(--color-terracotta-light);"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
          {tr.footer.bookVia}
        </a>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-white font-semibold text-sm tracking-widest uppercase mb-5">{tr.footer.nav}</h3>
        <ul class="space-y-3">
          <li><a href={`/${locale}/`} class="text-sm opacity-70 hover:opacity-100 transition-opacity">{tr.nav.home}</a></li>
          <li><a href={`/${locale}/courses/`} class="text-sm opacity-70 hover:opacity-100 transition-opacity">{tr.nav.courses}</a></li>
          <li><a href={`/${locale}/gallery/`} class="text-sm opacity-70 hover:opacity-100 transition-opacity">{tr.nav.gallery}</a></li>
          <li><a href={`/${locale}/contact/`} class="text-sm opacity-70 hover:opacity-100 transition-opacity">{tr.nav.contact}</a></li>
        </ul>
      </div>

      <!-- Social & contact -->
      <div>
        <h3 class="text-white font-semibold text-sm tracking-widest uppercase mb-5">{tr.footer.follow}</h3>
        <ul class="space-y-3">
          <li>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-2 text-sm opacity-70 hover:opacity-100 transition-opacity">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              {tr.footer.instagram}
            </a>
          </li>
          <li>
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-2 text-sm opacity-70 hover:opacity-100 transition-opacity">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              {tr.footer.facebook}
            </a>
          </li>
        </ul>
        <div class="mt-6 pt-6 border-t opacity-30" style="border-color: var(--color-blush);"></div>
        <p class="text-xs mt-0 opacity-50">hola@artebotanico.com</p>
        <p class="text-xs mt-1 opacity-50">Mallorca, Spain</p>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t flex flex-col sm:flex-row items-center justify-between gap-4"
         style="border-color: rgba(232,213,196,0.15);">
      <p class="text-xs opacity-40">
        {tr.footer.rights.replace('{year}', String(year))}
      </p>
      <div class="flex items-center gap-4">
        <a href={`/en/`} class="text-xs opacity-40 hover:opacity-70 transition-opacity">EN</a>
        <a href={`/de/`} class="text-xs opacity-40 hover:opacity-70 transition-opacity">DE</a>
        <a href={`/es/`} class="text-xs opacity-40 hover:opacity-70 transition-opacity">ES</a>
        <a href={`/no/`} class="text-xs opacity-40 hover:opacity-70 transition-opacity">NO</a>
        <a href={`/da/`} class="text-xs opacity-40 hover:opacity-70 transition-opacity">DA</a>
        <a href={`/sv/`} class="text-xs opacity-40 hover:opacity-70 transition-opacity">SV</a>
      </div>
    </div>
  </div>
</footer>
