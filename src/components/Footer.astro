---
import type { Locale } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const tr = t(locale);
const year = new Date().getFullYear();
---

<footer>
  <div class="container footer-inner">
    <!-- Brand -->
    <div class="footer-brand">
      <a href={`/${locale}/`} class="footer-logo">Arte <em>Botanico</em></a>
      <p class="footer-tagline">{tr.footer.tagline}</p>
    </div>

    <!-- Nav -->
    <nav class="footer-nav" aria-label="Footer navigation">
      <a href={`/${locale}/`}>{tr.nav.home}</a>
      <a href={`/${locale}/courses/`}>{tr.nav.courses}</a>
      <a href={`/${locale}/gallery/`}>{tr.nav.gallery}</a>
      <a href={`/${locale}/contact/`}>{tr.nav.contact}</a>
    </nav>

    <!-- Right -->
    <div class="footer-right">
      <a href="https://www.getyourguide.com" target="_blank" rel="noopener noreferrer" class="gyg-link">
        GetYourGuide ↗
      </a>
      <div class="lang-list">
        <a href="/en/">EN</a>
        <a href="/de/">DE</a>
        <a href="/es/">ES</a>
        <a href="/no/">NO</a>
        <a href="/da/">DA</a>
        <a href="/sv/">SV</a>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {year} Arte Botanico · Mallorca</span>
    <a href={`mailto:hola@artebotanico.com`}>hola@artebotanico.com</a>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
    padding: 4rem 0 2rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 3rem;
    align-items: start;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-border);
  }

  .footer-logo {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: var(--color-ink);
    text-decoration: none;
    display: block;
    margin-bottom: 0.6rem;
  }
  .footer-logo em { color: var(--color-accent); font-style: italic; }

  .footer-tagline {
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 26ch;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
  }
  .footer-nav a {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-nav a:hover { color: var(--color-ink); }

  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.25rem;
  }

  .gyg-link {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.1rem;
    transition: border-color 0.2s;
  }
  .gyg-link:hover { border-color: var(--color-ink); }

  .lang-list {
    display: flex;
    gap: 0.75rem;
  }
  .lang-list a {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    text-decoration: none;
    opacity: 0.6;
  }
  .lang-list a:hover { opacity: 1; color: var(--color-ink); }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    font-size: 0.7rem;
    color: var(--color-muted);
  }
  .footer-bottom a {
    color: var(--color-muted);
    text-decoration: none;
  }
  .footer-bottom a:hover { color: var(--color-ink); }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .footer-nav { align-items: center; flex-direction: row; flex-wrap: wrap; justify-content: center; }
    .footer-right { align-items: center; }
    .footer-bottom { flex-direction: column; gap: 0.5rem; text-align: center; }
  }
</style>
