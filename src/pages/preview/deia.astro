---
// DEIÀ — Gallery-minimal. Sun-bleached Mallorcan white, editorial type, near-zero colour.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
  <title>Preview: Deià — Arte Botanico</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg:      #F9F8F5;
      --bg-alt:  #F0EDE7;
      --dark:    #1C1C1A;
      --muted:   #7A7870;
      --accent:  #A8735F;
      --border:  rgba(28,28,26,.12);
      --fd:      'Cormorant Garamond', Georgia, serif;
      --fb:      'Inter', system-ui, sans-serif;
    }
    html { scroll-behavior: smooth; }
    body { background: var(--bg); color: var(--dark); font-family: var(--fb); font-size: 15px; line-height: 1.6; }

    /* ── Preview bar ───────────────────────────────── */
    .pbar {
      position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
      background: #0C0C0B; display: flex; align-items: center;
      gap: .5rem; padding: 0 1.25rem; height: 44px; overflow-x: auto;
    }
    .pbar-label { font-size: .65rem; font-weight: 600; letter-spacing: .15em; color: rgba(255,255,255,.35); text-transform: uppercase; white-space: nowrap; margin-right: .5rem; }
    .pbar a { font-size: .72rem; font-weight: 500; text-decoration: none; padding: .3rem .8rem; border-radius: 3px; white-space: nowrap; border: 1px solid transparent; transition: all .15s; }
    .pbar a.active { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.2); color: #fff; }
    .pbar a:not(.active) { color: rgba(255,255,255,.45); }
    .pbar a:not(.active):hover { color: rgba(255,255,255,.75); }

    /* ── Utility ───────────────────────────────────── */
    .wrap     { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }
    .wrap-md  { max-width: 900px;  margin: 0 auto; padding: 0 2rem; }
    .eyebrow  { font-family: var(--fb); font-size: .68rem; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); display: block; }
    .h1 { font-family: var(--fd); font-size: clamp(3rem, 6.5vw, 5.5rem); font-weight: 300; line-height: 1.05; letter-spacing: -.01em; }
    .h2 { font-family: var(--fd); font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 300; line-height: 1.1; letter-spacing: -.01em; color: var(--dark); }
    .h3 { font-family: var(--fd); font-size: 1.5rem; font-weight: 400; color: var(--dark); }
    .body-text { font-size: .9rem; line-height: 1.85; color: var(--muted); }
    hr.thin { border: none; border-top: 1px solid var(--border); }

    /* ── Buttons ───────────────────────────────────── */
    .btn { display: inline-block; font-family: var(--fb); font-size: .72rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; text-decoration: none; padding: .85rem 2.2rem; transition: all .2s; }
    .btn-dark  { background: var(--dark); color: var(--bg); }
    .btn-dark:hover { background: #3A3A36; }
    .btn-line  { border: 1px solid var(--dark); color: var(--dark); }
    .btn-line:hover { background: var(--dark); color: var(--bg); }
    .btn-ghost { border: 1px solid rgba(255,255,255,.4); color: rgba(255,255,255,.9); }
    .btn-ghost:hover { background: rgba(255,255,255,.1); }

    /* ── Header ────────────────────────────────────── */
    .site-header {
      position: sticky; top: 44px; z-index: 90;
      background: rgba(249,248,245,.95); backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
    }
    .header-inner { display: flex; align-items: center; justify-content: space-between; height: 68px; }
    .logo { font-family: var(--fd); font-size: 1.35rem; font-weight: 400; letter-spacing: .04em; color: var(--dark); text-decoration: none; }
    .logo span { color: var(--accent); font-style: italic; }
    .site-nav { display: flex; gap: 2.5rem; }
    .site-nav a { font-size: .72rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); text-decoration: none; transition: color .15s; }
    .site-nav a:hover { color: var(--dark); }
    .header-cta { font-size: .72rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--accent); padding-bottom: .1rem; }

    /* ── Hero ──────────────────────────────────────── */
    .hero { min-height: calc(100vh - 112px); display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
    .hero-text { display: flex; flex-direction: column; justify-content: center; padding: 6rem 4rem 6rem 0; border-right: 1px solid var(--border); }
    .hero-kicker { display: flex; align-items: center; gap: 1rem; margin-bottom: 2.5rem; }
    .hero-kicker-line { flex: 0 0 40px; height: 1px; background: var(--accent); }
    .hero-headline { margin-bottom: 2rem; }
    .hero-headline em { color: var(--accent); font-style: italic; }
    .hero-sub { font-size: .9rem; line-height: 1.85; color: var(--muted); max-width: 42ch; margin-bottom: 3rem; }
    .hero-actions { display: flex; gap: 1rem; align-items: center; }
    .hero-img-wrap { position: relative; overflow: hidden; }
    .hero-img { width: 100%; height: 100%; object-fit: cover; }
    .hero-img-caption { position: absolute; bottom: 1.5rem; left: 1.5rem; font-size: .65rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.6); }

    /* ── About ─────────────────────────────────────── */
    .about { padding: 8rem 0; border-top: 1px solid var(--border); }
    .about-inner { display: grid; grid-template-columns: 1fr 2fr; gap: 6rem; align-items: start; }
    .about-left { position: sticky; top: 120px; }
    .about-number { font-family: var(--fd); font-size: 8rem; font-weight: 300; line-height: 1; color: var(--border); letter-spacing: -.04em; }
    .about-stats { margin-top: 3rem; display: flex; flex-direction: column; gap: 1.5rem; }
    .stat-val { font-family: var(--fd); font-size: 2.2rem; font-weight: 300; color: var(--accent); }
    .stat-lbl { font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-top: .2rem; }
    .about-img { width: 100%; aspect-ratio: 3/4; object-fit: cover; margin-bottom: 3rem; }
    .about-text-block { max-width: 56ch; }
    .about-text-block p + p { margin-top: 1.25rem; }

    /* ── Courses ───────────────────────────────────── */
    .courses { padding: 8rem 0; background: var(--bg-alt); }
    .courses-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 4rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
    .course-list { display: grid; grid-template-columns: repeat(3,1fr); gap: 0; border-left: 1px solid var(--border); border-top: 1px solid var(--border); }
    .course-item { padding: 2.5rem 2rem; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .course-num { font-family: var(--fd); font-size: .85rem; color: var(--muted); font-style: italic; margin-bottom: 1rem; }
    .course-audience { font-size: .65rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); margin-bottom: .6rem; display: block; }
    .course-title { font-family: var(--fd); font-size: 1.4rem; font-weight: 400; color: var(--dark); margin-bottom: .75rem; }
    .course-desc { font-size: .82rem; line-height: 1.75; color: var(--muted); margin-bottom: 1.5rem; }
    .course-link { font-size: .68rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--dark); text-decoration: none; border-bottom: 1px solid var(--border); padding-bottom: .1rem; transition: border-color .2s; }
    .course-link:hover { border-color: var(--dark); }

    /* ── GYG ───────────────────────────────────────── */
    .gyg { padding: 7rem 0; border-top: 1px solid var(--border); }
    .gyg-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: center; }
    .gyg-label { font-size: .68rem; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); margin-bottom: 1.25rem; display: flex; align-items: center; gap: .75rem; }
    .gyg-label::before { content: ''; display: inline-block; width: 24px; height: 1px; background: var(--accent); }
    .gyg-title { font-family: var(--fd); font-size: clamp(1.8rem,3.5vw,2.8rem); font-weight: 300; line-height: 1.15; margin-bottom: 1.5rem; }
    .gyg-body { font-size: .88rem; line-height: 1.85; color: var(--muted); margin-bottom: 2.5rem; max-width: 46ch; }
    .gyg-img { width: 100%; aspect-ratio: 4/3; object-fit: cover; }

    /* ── Gallery ───────────────────────────────────── */
    .gallery { padding: 8rem 0; background: var(--bg-alt); border-top: 1px solid var(--border); }
    .gallery-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 3rem; }
    .gallery-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 3px; }
    .gallery-item { overflow: hidden; }
    .gallery-item:first-child { grid-column: span 2; }
    .gallery-img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 1; transition: transform .5s; display: block; }
    .gallery-item:first-child .gallery-img { aspect-ratio: auto; height: 100%; }
    .gallery-item:hover .gallery-img { transform: scale(1.04); }

    /* ── Footer ────────────────────────────────────── */
    .footer { padding: 4rem 0; border-top: 1px solid var(--border); }
    .footer-inner { display: flex; align-items: center; justify-content: space-between; }
    .footer-logo { font-family: var(--fd); font-size: 1.1rem; font-weight: 400; color: var(--dark); }
    .footer-copy { font-size: .72rem; color: var(--muted); }
    .footer-links { display: flex; gap: 1.5rem; }
    .footer-links a { font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); text-decoration: none; }
    .footer-links a:hover { color: var(--dark); }
  </style>
</head>
<body>

<!-- Preview bar -->
<div class="pbar">
  <span class="pbar-label">Style Preview</span>
  <a href="/preview/deia" class="active">Deià — Gallery Minimal</a>
  <a href="/preview/tramuntana">Tramuntana — Warm &amp; Dark</a>
  <a href="/preview/ponent">Ponent — Cinematic Island</a>
</div>

<!-- Header -->
<header class="site-header">
  <div class="wrap header-inner">
    <a href="#" class="logo">Arte <span>Botanico</span></a>
    <nav class="site-nav">
      <a href="#">Home</a>
      <a href="#">Courses</a>
      <a href="#">Gallery</a>
      <a href="#">Contact</a>
    </nav>
    <a href="#" class="header-cta">Book Now</a>
  </div>
</header>

<!-- Hero -->
<section class="hero">
  <div class="wrap" style="display:contents;">
    <div class="hero-text" style="padding-left:2rem; padding-right:3rem; max-width:680px;">
      <div class="hero-kicker">
        <span class="hero-kicker-line"></span>
        <span class="eyebrow">Art Studio · Mallorca</span>
      </div>
      <h1 class="h1 hero-headline">
        Discover your<br><em>creative side</em><br>in paradise
      </h1>
      <p class="hero-sub">Painting classes, resin workshops &amp; pottery in the heart of Mallorca — for curious beginners and seasoned artists alike.</p>
      <div class="hero-actions">
        <a href="#" class="btn btn-dark">Explore Courses</a>
        <a href="#" class="btn btn-line">Book via GetYourGuide</a>
      </div>
    </div>
    <div class="hero-img-wrap">
      <img src="https://images.unsplash.com/photo-1490730141103-6cac27aaab94?w=1200&q=85" alt="Studio" class="hero-img" />
      <span class="hero-img-caption">Arte Botanico · Mallorca</span>
    </div>
  </div>
</section>

<!-- About -->
<section class="about">
  <div class="wrap about-inner">
    <div class="about-left">
      <span class="eyebrow" style="margin-bottom:1rem;">About</span>
      <div class="about-number">01</div>
      <div class="about-stats">
        <div><div class="stat-val">6+</div><div class="stat-lbl">Course types</div></div>
        <div><div class="stat-val">6</div><div class="stat-lbl">Languages</div></div>
        <div><div class="stat-val">∞</div><div class="stat-lbl">Creativity</div></div>
      </div>
    </div>
    <div>
      <img src="https://images.unsplash.com/photo-1547826039-bfc35e0f1ea8?w=900&q=80" alt="Artist" class="about-img" />
      <div class="about-text-block">
        <h2 class="h2" style="margin-bottom:1.5rem;">Where art meets the soul of Mallorca</h2>
        <p class="body-text">Arte Botanico is a warm, welcoming atelier nestled on the beautiful island of Mallorca. Our studio offers a sanctuary where creativity flourishes — surrounded by Mediterranean light, botanical gardens, and the tranquil pace of island life.</p>
        <p class="body-text">Whether you're picking up a brush for the very first time or deepening a lifelong practice, our small-group classes ensure personal attention and the joy of making something beautiful with your hands.</p>
        <div style="margin-top:2.5rem;"><a href="#" class="btn btn-line">About the Studio</a></div>
      </div>
    </div>
  </div>
</section>

<!-- Courses -->
<section class="courses">
  <div class="wrap">
    <div class="courses-header">
      <div>
        <span class="eyebrow" style="margin-bottom:.75rem;">What we offer</span>
        <h2 class="h2">Courses &amp; Workshops</h2>
      </div>
      <a href="#" class="btn btn-line">All Courses</a>
    </div>
    <div class="course-list">
      <div class="course-item">
        <div class="course-num">01</div>
        <span class="course-audience">Children &amp; Adults</span>
        <div class="course-title">Acrylic Painting</div>
        <p class="course-desc">Layering, texture and colour mixing in a vibrant, supportive environment. All skill levels welcome.</p>
        <a href="#" class="course-link">Learn more</a>
      </div>
      <div class="course-item">
        <div class="course-num">02</div>
        <span class="course-audience">Children &amp; Adults</span>
        <div class="course-title">Watercolor / Aquarelle</div>
        <p class="course-desc">Wet-on-wet, gradients and botanical illustration guided by Mediterranean light and colour.</p>
        <a href="#" class="course-link">Learn more</a>
      </div>
      <div class="course-item">
        <div class="course-num">03</div>
        <span class="course-audience">Adults only</span>
        <div class="course-title">Resin Art Workshop</div>
        <p class="course-desc">Create jewellery, trays and wall art with epoxy resin. No experience needed.</p>
        <a href="#" class="course-link">Learn more</a>
      </div>
      <div class="course-item">
        <div class="course-num">04</div>
        <span class="course-audience">Adults only</span>
        <div class="course-title">Pottery Workshop</div>
        <p class="course-desc">Hand-building with clay — pinching, coiling, slab construction. Your own ceramic piece to keep.</p>
        <a href="#" class="course-link">Learn more</a>
      </div>
      <div class="course-item">
        <div class="course-num">05</div>
        <span class="course-audience">All ages</span>
        <div class="course-title">Private Classes at Home</div>
        <p class="course-desc">We come to you, anywhere on Mallorca. Fully personalised sessions at your own pace.</p>
        <a href="#" class="course-link">Learn more</a>
      </div>
      <div class="course-item">
        <div class="course-num">06</div>
        <span class="course-audience">Residents</span>
        <div class="course-title">Open Studio</div>
        <p class="course-desc">Regular sessions for long-term residents — paint together, experiment and connect.</p>
        <a href="#" class="course-link">Learn more</a>
      </div>
    </div>
  </div>
</section>

<!-- GetYourGuide -->
<section class="gyg">
  <div class="wrap gyg-inner">
    <div>
      <p class="gyg-label">Booking partner</p>
      <h2 class="gyg-title">Book your experience<br>on GetYourGuide</h2>
      <p class="gyg-body">Instant booking, flexible cancellation, and available in your language. Our courses are listed directly on the world's leading experiences platform.</p>
      <a href="#" class="btn btn-dark">Find Us on GetYourGuide ↗</a>
    </div>
    <img src="https://images.unsplash.com/photo-1460661419201-fd4cecdf8a8b?w=800&q=80" alt="Art supplies" class="gyg-img" />
  </div>
</section>

<!-- Gallery -->
<section class="gallery">
  <div class="wrap">
    <div class="gallery-header">
      <div>
        <span class="eyebrow" style="margin-bottom:.6rem;">Our work</span>
        <h2 class="h2">A glimpse into the studio</h2>
      </div>
      <a href="#" class="btn btn-line">Full Gallery</a>
    </div>
    <div class="gallery-grid">
      <div class="gallery-item"><img src="https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?w=800&q=80" alt="Watercolor" class="gallery-img" /></div>
      <div class="gallery-item"><img src="https://images.unsplash.com/photo-1513364776144-60967b0f800f?w=500&q=80" alt="Painting" class="gallery-img" /></div>
      <div class="gallery-item"><img src="https://images.unsplash.com/photo-1565193566173-7a0ee3dbe261?w=500&q=80" alt="Pottery" class="gallery-img" /></div>
      <div class="gallery-item"><img src="https://images.unsplash.com/photo-1572635148818-ef6fd45eb394?w=500&q=80" alt="Studio" class="gallery-img" /></div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="footer">
  <div class="wrap footer-inner">
    <span class="footer-logo">Arte Botanico · Mallorca</span>
    <div class="footer-links">
      <a href="#">Courses</a>
      <a href="#">Gallery</a>
      <a href="#">Contact</a>
      <a href="#">GetYourGuide</a>
    </div>
    <span class="footer-copy">© 2026 Arte Botanico</span>
  </div>
</footer>

</body>
</html>
