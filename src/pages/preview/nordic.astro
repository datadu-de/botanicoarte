---
import PreviewNav from '../../components/PreviewNav.astro';
import PreviewHome from '../../components/PreviewHome.astro';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Nunito+Sans:wght@300;400;600&display=swap" rel="stylesheet" />
  <title>Style Preview: Nordic – Arte Botanico</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --pv-bg:            #F8F7F4;
      --pv-bg-alt:        #EDECEA;
      --pv-accent:        #8B6647;
      --pv-accent-text:   #ffffff;
      --pv-heading:       #1E2B2B;
      --pv-body-color:    #3C4848;
      --pv-green:         #4A6B6B;
      --pv-font-display:  'Libre Baskerville', Georgia, serif;
      --pv-font-body:     'Nunito Sans', system-ui, sans-serif;
      --pv-radius:        3px;
      --pv-card-radius:   3px;
      --pv-hero-overlay:  linear-gradient(to right, rgba(30,43,43,.8) 0%, rgba(30,43,43,.35) 100%);
      --pv-badge-bg:      rgba(139,102,71,.2);
      --pv-badge-color:   #D2B89A;
      --pv-badge-border:  rgba(139,102,71,.35);
      --pv-header-bg:     rgba(248,247,244,.97);
      --pv-border:        rgba(180,170,158,.3);
      --pv-card-bg:       #FFFFFF;
      --pv-icon-bg:       rgba(139,102,71,.1);
      --pv-deco-1:        #C4A882;
      --pv-deco-2:        #7B9898;
      --pv-gyg-bg:        #1E2B2B;
      --pv-gyg-color:     #1E2B2B;
    }

    body { background: var(--pv-bg); color: var(--pv-body-color); font-family: var(--pv-font-body); }

    /* Nordic: clean, generous spacing, understated elegance */
    :global(.pv-section)          { padding: 6rem 0; }
    :global(.pv-eyebrow)          { letter-spacing: 0.2em; font-size: 0.68rem; }
    :global(.pv-section-title)    { font-weight: 400; letter-spacing: -0.01em; }
    :global(.pv-hero-headline)    { font-weight: 400; letter-spacing: -0.01em; }
    :global(.pv-gyg-title)        { font-weight: 400; }
    :global(.pv-btn-primary)      { letter-spacing: 0.08em; }
    :global(.pv-navlink)          { font-weight: 400; letter-spacing: 0.04em; }
    :global(.pv-course-card)      { border-color: rgba(180,170,158,.25); background: #FAFAF8; }
  </style>
</head>
<body>
  <PreviewNav current="nordic" />
  <PreviewHome />
</body>
</html>
