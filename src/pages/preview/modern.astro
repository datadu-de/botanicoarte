---
import PreviewNav from '../../components/PreviewNav.astro';
import PreviewHome from '../../components/PreviewHome.astro';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <title>Style Preview: Modern – Arte Botanico</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --pv-bg:            #FFFFFF;
      --pv-bg-alt:        #F4F4F2;
      --pv-accent:        #111111;
      --pv-accent-text:   #ffffff;
      --pv-heading:       #080808;
      --pv-body-color:    #3A3A3A;
      --pv-green:         #767676;
      --pv-font-display:  'Playfair Display', Georgia, serif;
      --pv-font-body:     'Inter', system-ui, sans-serif;
      --pv-radius:        0px;
      --pv-card-radius:   0px;
      --pv-hero-overlay:  linear-gradient(to right, rgba(0,0,0,.78) 30%, rgba(0,0,0,.2) 100%);
      --pv-badge-bg:      rgba(255,255,255,.12);
      --pv-badge-color:   rgba(255,255,255,.88);
      --pv-badge-border:  rgba(255,255,255,.3);
      --pv-header-bg:     rgba(255,255,255,.97);
      --pv-border:        #E2E2E2;
      --pv-card-bg:       #FFFFFF;
      --pv-icon-bg:       #ECECEC;
      --pv-deco-1:        #E0E0E0;
      --pv-deco-2:        #F0F0F0;
      --pv-gyg-bg:        #080808;
      --pv-gyg-color:     #080808;
    }

    body { background: var(--pv-bg); color: var(--pv-body-color); font-family: var(--pv-font-body); }

    /* Modern overrides – tighter letter-spacing, uppercase eyebrows feel more gallery */
    :global(.pv-eyebrow)       { letter-spacing: 0.22em; }
    :global(.pv-section-title) { font-weight: 400; letter-spacing: -0.01em; }
    :global(.pv-course-card)   { border-color: #E2E2E2; }
    :global(.pv-navlink)       { font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; }
    :global(.pv-btn-primary)   { border-radius: 0; letter-spacing: 0.1em; }
    :global(.pv-btn-outline)   { border-radius: 0; letter-spacing: 0.1em; }
    :global(.pv-btn-white)     { border-radius: 0; }
  </style>
</head>
<body>
  <PreviewNav current="modern" />
  <PreviewHome />
</body>
</html>
