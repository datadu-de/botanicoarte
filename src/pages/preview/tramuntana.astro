---
// TRAMUNTANA — Painterly warmth meets dramatic contrast. Named after Mallorca's mountain range.
// Palette: warm parchment + deep olive-forest + ochre gold.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Raleway:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <title>Preview: Tramuntana — Arte Botanico</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --parch:   #F2EBE0;
      --parch-d: #E6DDD0;
      --forest:  #1A2820;
      --forest-l:#253B2F;
      --ochre:   #C08A3A;
      --ochre-l: #D9A85C;
      --sage:    #6A8E78;
      --text:    #2A2820;
      --muted:   #7A7060;
      --border:  rgba(42,40,32,.12);
      --fd:      'Crimson Pro', Georgia, serif;
      --fb:      'Raleway', system-ui, sans-serif;
    }
    html { scroll-behavior: smooth; }
    body { background: var(--parch); color: var(--text); font-family: var(--fb); font-size: 15px; }

    /* ── Preview bar ──── */
    .pbar { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; background: #0A0F0D; display: flex; align-items: center; gap: .5rem; padding: 0 1.25rem; height: 44px; overflow-x: auto; }
    .pbar-label { font-size: .65rem; font-weight: 600; letter-spacing: .15em; color: rgba(255,255,255,.35); text-transform: uppercase; white-space: nowrap; margin-right: .5rem; }
    .pbar a { font-size: .72rem; font-weight: 500; text-decoration: none; padding: .3rem .8rem; border-radius: 3px; white-space: nowrap; border: 1px solid transparent; transition: all .15s; }
    .pbar a.active { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.2); color: #fff; }
    .pbar a:not(.active) { color: rgba(255,255,255,.45); }
    .pbar a:not(.active):hover { color: rgba(255,255,255,.75); }

    /* ── Utility ──── */
    .wrap    { max-width: 1280px; margin: 0 auto; padding: 0 2.5rem; }
    .wrap-sm { max-width: 760px;  margin: 0 auto; padding: 0 2.5rem; }
    .eyebrow { font-family: var(--fb); font-size: .68rem; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--ochre); display: block; }
    .h1 { font-family: var(--fd); font-size: clamp(2.8rem,6vw,5rem); font-weight: 300; line-height: 1.08; }
    .h2 { font-family: var(--fd); font-size: clamp(1.8rem,3.5vw,3rem); font-weight: 300; line-height: 1.12; }
    .h3 { font-family: var(--fd); font-size: 1.6rem; font-weight: 400; }
    .body-t { font-size: .88rem; line-height: 1.9; color: var(--muted); font-weight: 400; }

    /* ── Buttons ──── */
    .btn { display: inline-block; font-family: var(--fb); font-size: .7rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; text-decoration: none; padding: .9rem 2.2rem; transition: all .2s; }
    .btn-ochre  { background: var(--ochre); color: #fff; }
    .btn-ochre:hover { background: var(--ochre-l); }
    .btn-forest { background: var(--forest); color: var(--parch); }
    .btn-forest:hover { background: var(--forest-l); }
    .btn-outline-light { border: 1.5px solid rgba(255,255,255,.45); color: rgba(255,255,255,.9); }
    .btn-outline-light:hover { background: rgba(255,255,255,.1); }
    .btn-outline-dark { border: 1.5px solid var(--text); color: var(--text); }
    .btn-outline-dark:hover { background: var(--text); color: var(--parch); }

    /* ── Header ──── */
    .site-header { position: sticky; top: 44px; z-index: 90; background: rgba(242,235,224,.96); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); }
    .header-inner { display: flex; align-items: center; justify-content: space-between; height: 70px; }
    .logo { display: flex; align-items: center; gap: .75rem; text-decoration: none; }
    .logo-mark { width: 36px; height: 36px; background: var(--forest); border-radius: 2px; display: flex; align-items: center; justify-content: center; font-family: var(--fd); font-size: .9rem; color: var(--ochre-l); font-weight: 500; }
    .logo-name { font-family: var(--fd); font-size: 1.2rem; font-weight: 400; color: var(--text); }
    .logo-sub  { font-family: var(--fb); font-size: .6rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
    .site-nav { display: flex; gap: 2rem; }
    .site-nav a { font-size: .72rem; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); text-decoration: none; transition: color .15s; }
    .site-nav a:hover { color: var(--text); }
    .header-cta { background: var(--ochre); color: #fff; font-size: .68rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; padding: .55rem 1.4rem; text-decoration: none; transition: background .2s; }
    .header-cta:hover { background: var(--ochre-l); }

    /* ── Hero ──── */
    .hero { position: relative; min-height: calc(100vh - 114px); display: flex; align-items: flex-end; overflow: hidden; }
    .hero-bg { position: absolute; inset: 0; }
    .hero-bg img { width: 100%; height: 100%; object-fit: cover; }
    .hero-bg-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(26,40,32,.92) 0%, rgba(26,40,32,.55) 50%, rgba(26,40,32,.18) 100%); }
    .hero-content { position: relative; z-index: 1; padding: 5rem 2.5rem; max-width: 1280px; margin: 0 auto; width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: end; }
    .hero-left {}
    .hero-kicker { display: flex; align-items: center; gap: .75rem; margin-bottom: 1.75rem; }
    .kicker-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ochre); }
    .hero-headline { color: #fff; margin-bottom: 1.5rem; }
    .hero-headline em { color: var(--ochre-l); font-style: italic; }
    .hero-sub { font-size: .9rem; line-height: 1.8; color: rgba(242,235,224,.75); margin-bottom: 2.5rem; max-width: 46ch; }
    .hero-actions { display: flex; gap: 1rem; }
    .hero-right { display: flex; flex-direction: column; align-items: flex-end; gap: 1.5rem; padding-bottom: .5rem; }
    .hero-stat { text-align: right; }
    .hero-stat-val { font-family: var(--fd); font-size: 3rem; font-weight: 300; color: var(--ochre-l); line-height: 1; }
    .hero-stat-lbl { font-size: .65rem; letter-spacing: .14em; text-transform: uppercase; color: rgba(242,235,224,.5); margin-top: .2rem; }
    .hero-divider { width: 1px; height: 60px; background: rgba(242,235,224,.2); }

    /* ── About ──── */
    .about { padding: 0; }
    .about-inner { display: grid; grid-template-columns: 1fr 1fr; }
    .about-img-side { position: relative; min-height: 600px; overflow: hidden; }
    .about-img { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
    .about-text-side { padding: 6rem 5rem; background: var(--parch-d); display: flex; flex-direction: column; justify-content: center; }
    .about-eyebrow { margin-bottom: 1.5rem; }
    .about-title { margin-bottom: 1.75rem; }
    .about-title em { color: var(--ochre); font-style: italic; }
    .about-body + .about-body { margin-top: 1.1rem; }
    .about-cta { margin-top: 2.5rem; }

    /* ── Courses ──── */
    .courses { background: var(--forest); padding: 7rem 0; }
    .courses-top { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 4rem; padding-bottom: 2rem; border-bottom: 1px solid rgba(255,255,255,.1); }
    .courses-eyebrow { color: var(--ochre) !important; }
    .courses-title { color: #fff; }
    .course-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.5px; }
    .course-card { background: var(--forest-l); padding: 2.5rem 2rem; transition: background .2s; }
    .course-card:hover { background: #2E4A38; }
    .course-tag { display: inline-block; font-size: .62rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--ochre-l); background: rgba(192,138,58,.12); padding: .3rem .65rem; margin-bottom: 1.1rem; }
    .course-name { font-family: var(--fd); font-size: 1.45rem; font-weight: 400; color: #fff; margin-bottom: .75rem; line-height: 1.2; }
    .course-text { font-size: .82rem; line-height: 1.75; color: rgba(242,235,224,.6); margin-bottom: 1.5rem; }
    .course-cta { font-size: .68rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--ochre); text-decoration: none; }
    .course-cta:hover { color: var(--ochre-l); }

    /* ── GYG ──── */
    .gyg { padding: 7rem 0; }
    .gyg-inner { display: grid; grid-template-columns: 5fr 4fr; gap: 7rem; align-items: center; }
    .gyg-eyebrow { margin-bottom: 1.25rem; }
    .gyg-title { margin-bottom: 1.5rem; }
    .gyg-title em { color: var(--ochre); font-style: italic; }
    .gyg-body { font-size: .88rem; line-height: 1.9; color: var(--muted); margin-bottom: 2.5rem; max-width: 48ch; }
    .gyg-img-wrap { position: relative; }
    .gyg-img { width: 100%; aspect-ratio: 4/3; object-fit: cover; }
    .gyg-badge { position: absolute; bottom: -1rem; left: -1rem; background: var(--ochre); padding: 1rem 1.5rem; }
    .gyg-badge-text { font-family: var(--fd); font-size: 1rem; font-weight: 400; color: #fff; }

    /* ── Gallery ──── */
    .gallery { background: var(--parch-d); padding: 7rem 0; }
    .gallery-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2.5rem; }
    .gal-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-template-rows: 280px 280px; gap: 4px; }
    .gal-item { overflow: hidden; }
    .gal-item:first-child { grid-row: span 2; }
    .gal-img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; display: block; }
    .gal-item:hover .gal-img { transform: scale(1.04); }

    /* ── Footer ──── */
    .footer { background: var(--forest); padding: 4rem 0; }
    .footer-inner { display: flex; align-items: center; justify-content: space-between; }
    .footer-brand { font-family: var(--fd); font-size: 1.1rem; font-weight: 300; color: rgba(242,235,224,.7); }
    .footer-links { display: flex; gap: 2rem; }
    .footer-links a { font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(242,235,224,.4); text-decoration: none; }
    .footer-links a:hover { color: rgba(242,235,224,.8); }
    .footer-copy { font-size: .68rem; color: rgba(242,235,224,.3); }
  </style>
</head>
<body>

<div class="pbar">
  <span class="pbar-label">Style Preview</span>
  <a href="/preview/deia">Deià — Gallery Minimal</a>
  <a href="/preview/tramuntana" class="active">Tramuntana — Warm &amp; Dark</a>
  <a href="/preview/ponent">Ponent — Cinematic Island</a>
</div>

<header class="site-header">
  <div class="wrap header-inner">
    <a href="#" class="logo">
      <div class="logo-mark">AB</div>
      <div><div class="logo-name">Arte Botanico</div><div class="logo-sub">Mallorca</div></div>
    </a>
    <nav class="site-nav">
      <a href="#">Home</a><a href="#">Courses</a><a href="#">Gallery</a><a href="#">Contact</a>
    </nav>
    <a href="#" class="header-cta">Book Now</a>
  </div>
</header>

<!-- Hero -->
<section class="hero">
  <div class="hero-bg">
    <img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1600&q=80" alt="Mallorca" />
    <div class="hero-bg-overlay"></div>
  </div>
  <div class="hero-content">
    <div class="hero-left">
      <div class="hero-kicker">
        <span class="kicker-dot"></span>
        <span style="font-size:.68rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--ochre);">Art Studio · Mallorca</span>
      </div>
      <h1 class="h1 hero-headline">Discover your<br><em>creative side</em><br>in paradise</h1>
      <p class="hero-sub">Painting, resin workshops &amp; pottery in the heart of Mallorca — for curious beginners and seasoned artists alike.</p>
      <div class="hero-actions">
        <a href="#" class="btn btn-ochre">Explore Courses</a>
        <a href="#" class="btn btn-outline-light">GetYourGuide ↗</a>
      </div>
    </div>
    <div class="hero-right">
      <div class="hero-stat"><div class="hero-stat-val">6+</div><div class="hero-stat-lbl">Course types</div></div>
      <div class="hero-divider"></div>
      <div class="hero-stat"><div class="hero-stat-val">6</div><div class="hero-stat-lbl">Languages</div></div>
      <div class="hero-divider"></div>
      <div class="hero-stat"><div class="hero-stat-val">∞</div><div class="hero-stat-lbl">Creativity</div></div>
    </div>
  </div>
</section>

<!-- About -->
<section class="about">
  <div class="about-inner">
    <div class="about-img-side">
      <img src="https://images.unsplash.com/photo-1547826039-bfc35e0f1ea8?w=900&q=80" alt="Artist" class="about-img" />
    </div>
    <div class="about-text-side">
      <span class="eyebrow about-eyebrow">Welcome to Arte Botanico</span>
      <h2 class="h2 about-title">Where art meets the<br><em>soul of Mallorca</em></h2>
      <p class="body-t about-body">Arte Botanico is a warm, welcoming atelier nestled on the beautiful island of Mallorca. Our studio offers a sanctuary where creativity flourishes — surrounded by Mediterranean light, botanical gardens, and the tranquil pace of island life.</p>
      <p class="body-t about-body">Whether you're picking up a brush for the very first time or deepening a lifelong practice, our small-group classes ensure personal attention and the joy of making something beautiful.</p>
      <div class="about-cta"><a href="#" class="btn btn-outline-dark">About the Studio</a></div>
    </div>
  </div>
</section>

<!-- Courses -->
<section class="courses">
  <div class="wrap">
    <div class="courses-top">
      <div>
        <span class="eyebrow courses-eyebrow" style="margin-bottom:.75rem;">What we offer</span>
        <h2 class="h2 courses-title">Courses &amp; Workshops</h2>
      </div>
      <a href="#" class="btn btn-outline-light">All Courses</a>
    </div>
    <div class="course-grid">
      {[
        ['Children & Adults','Acrylic Painting','Layering, texture and colour mixing in a vibrant, supportive environment.'],
        ['Children & Adults','Watercolor / Aquarelle','Wet-on-wet, gradients and botanical illustration guided by Mediterranean light.'],
        ['Adults only','Resin Art Workshop','Create jewellery, trays and wall art with epoxy resin. No experience needed.'],
        ['Adults only','Pottery Workshop','Hand-building with clay — your own ceramic piece to take home.'],
        ['All ages','Private Classes at Home','We come to you, anywhere on Mallorca. Fully personalised sessions.'],
        ['Residents','Open Studio','Regular sessions for long-term residents — paint together and connect.'],
      ].map(([aud, name, desc]) => (
        <div class="course-card">
          <span class="course-tag">{aud}</span>
          <div class="course-name">{name}</div>
          <p class="course-text">{desc}</p>
          <a href="#" class="course-cta">Book now →</a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- GYG -->
<section class="gyg">
  <div class="wrap gyg-inner">
    <div>
      <span class="eyebrow gyg-eyebrow" style="margin-bottom:1.25rem;">Booking partner</span>
      <h2 class="h2 gyg-title">Book your experience<br>on <em>GetYourGuide</em></h2>
      <p class="gyg-body">Instant booking, flexible cancellation, available in your language. Our courses are listed directly on the world's leading experiences platform.</p>
      <a href="#" class="btn btn-forest">Find Us on GetYourGuide ↗</a>
    </div>
    <div class="gyg-img-wrap">
      <img src="https://images.unsplash.com/photo-1460661419201-fd4cecdf8a8b?w=700&q=80" alt="Studio" class="gyg-img" />
      <div class="gyg-badge"><div class="gyg-badge-text">Book Instantly</div></div>
    </div>
  </div>
</section>

<!-- Gallery -->
<section class="gallery">
  <div class="wrap">
    <div class="gallery-header">
      <div>
        <span class="eyebrow" style="margin-bottom:.6rem;">Our work</span>
        <h2 class="h2">A glimpse into the studio</h2>
      </div>
      <a href="#" class="btn btn-outline-dark">Full Gallery</a>
    </div>
    <div class="gal-grid">
      <div class="gal-item"><img src="https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?w=900&q=80" alt="Watercolor" class="gal-img" /></div>
      <div class="gal-item"><img src="https://images.unsplash.com/photo-1513364776144-60967b0f800f?w=500&q=80" alt="Painting" class="gal-img" /></div>
      <div class="gal-item"><img src="https://images.unsplash.com/photo-1565193566173-7a0ee3dbe261?w=500&q=80" alt="Pottery" class="gal-img" /></div>
      <div class="gal-item"><img src="https://images.unsplash.com/photo-1510832842230-87253f48d74f?w=500&q=80" alt="Watercolor botanical" class="gal-img" /></div>
      <div class="gal-item"><img src="https://images.unsplash.com/photo-1572635148818-ef6fd45eb394?w=500&q=80" alt="Studio" class="gal-img" /></div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="footer">
  <div class="wrap footer-inner">
    <span class="footer-brand">Arte Botanico · Mallorca</span>
    <div class="footer-links">
      <a href="#">Courses</a><a href="#">Gallery</a><a href="#">Contact</a><a href="#">GetYourGuide</a>
    </div>
    <span class="footer-copy">© 2026 Arte Botanico</span>
  </div>
</footer>

</body>
</html>
