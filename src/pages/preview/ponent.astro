---
// PONENT — Cinematic island. Linen + near-black olive + amber + sea-blue.
// Named after the Mallorcan west wind and the direction of the setting sun.
// Design: full-bleed images carry the mood; type is confident but restrained.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300;1,9..144,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
  <title>Preview: Ponent — Arte Botanico</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --linen:   #F5F1E9;
      --linen-d: #EAE4D8;
      --ink:     #0E1610;
      --ink-l:   #182218;
      --amber:   #C4834A;
      --amber-l: #D9A070;
      --sea:     #5C879E;
      --sea-l:   #7AA2B6;
      --text:    #2C2518;
      --muted:   #7A7060;
      --border:  rgba(44,37,24,.1);
      --fd:      'Fraunces', Georgia, serif;
      --fb:      'DM Sans', system-ui, sans-serif;
    }
    html { scroll-behavior: smooth; }
    body { background: var(--linen); color: var(--text); font-family: var(--fb); font-size: 15px; }

    /* ── Preview bar ──── */
    .pbar { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; background: #080C09; display: flex; align-items: center; gap: .5rem; padding: 0 1.25rem; height: 44px; overflow-x: auto; }
    .pbar-label { font-size: .65rem; font-weight: 500; letter-spacing: .15em; color: rgba(255,255,255,.3); text-transform: uppercase; white-space: nowrap; margin-right: .5rem; }
    .pbar a { font-size: .72rem; font-weight: 500; text-decoration: none; padding: .3rem .8rem; border-radius: 3px; white-space: nowrap; border: 1px solid transparent; transition: all .15s; }
    .pbar a.active { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.2); color: #fff; }
    .pbar a:not(.active) { color: rgba(255,255,255,.4); }
    .pbar a:not(.active):hover { color: rgba(255,255,255,.75); }

    /* ── Utility ──── */
    .wrap    { max-width: 1280px; margin: 0 auto; padding: 0 2.5rem; }
    .eyebrow { font-family: var(--fb); font-size: .68rem; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: var(--amber); display: block; }
    .h1 { font-family: var(--fd); font-size: clamp(2.8rem,6vw,4.8rem); font-weight: 300; line-height: 1.08; letter-spacing: -.01em; }
    .h2 { font-family: var(--fd); font-size: clamp(1.8rem,3.5vw,3rem); font-weight: 300; line-height: 1.12; }
    .body-t { font-size: .88rem; line-height: 1.9; color: var(--muted); }

    /* ── Buttons ──── */
    .btn { display: inline-block; font-family: var(--fb); font-size: .7rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; text-decoration: none; padding: .85rem 2rem; transition: all .2s; }
    .btn-amber { background: var(--amber); color: #fff; }
    .btn-amber:hover { background: var(--amber-l); }
    .btn-ink { background: var(--ink); color: var(--linen); }
    .btn-ink:hover { background: var(--ink-l); }
    .btn-sea { background: var(--sea); color: #fff; }
    .btn-sea:hover { background: var(--sea-l); }
    .btn-ghost-light { border: 1.5px solid rgba(255,255,255,.4); color: rgba(255,255,255,.9); }
    .btn-ghost-light:hover { background: rgba(255,255,255,.1); }
    .btn-outline { border: 1.5px solid var(--text); color: var(--text); }
    .btn-outline:hover { background: var(--text); color: var(--linen); }

    /* ── Header ──── */
    .site-header { position: sticky; top: 44px; z-index: 90; background: rgba(245,241,233,.96); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); }
    .header-inner { display: flex; align-items: center; justify-content: space-between; height: 68px; }
    .logo { text-decoration: none; display: flex; flex-direction: column; line-height: 1.1; }
    .logo-name { font-family: var(--fd); font-size: 1.15rem; font-weight: 400; color: var(--text); letter-spacing: .01em; }
    .logo-sub { font-family: var(--fb); font-size: .58rem; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; color: var(--amber); }
    .site-nav { display: flex; gap: 2rem; }
    .site-nav a { font-size: .7rem; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); text-decoration: none; transition: color .15s; }
    .site-nav a:hover { color: var(--text); }
    .header-right { display: flex; align-items: center; gap: 1rem; }
    .header-lang { font-size: .65rem; font-weight: 500; letter-spacing: .14em; color: var(--amber); text-decoration: none; border: 1px solid rgba(196,131,74,.3); padding: .3rem .6rem; }

    /* ── Hero ──── */
    .hero { position: relative; min-height: calc(100vh - 112px); display: flex; align-items: center; }
    .hero-bg { position: absolute; inset: 0; overflow: hidden; }
    .hero-bg img { width: 100%; height: 100%; object-fit: cover; }
    .hero-overlay { position: absolute; inset: 0; background: linear-gradient(105deg, rgba(14,22,16,.88) 0%, rgba(14,22,16,.5) 55%, transparent 100%); }
    .hero-body { position: relative; z-index: 1; padding: 0 2.5rem; max-width: 1280px; margin: 0 auto; width: 100%; }
    .hero-inner { max-width: 660px; }
    .hero-tag { display: inline-flex; align-items: center; gap: .6rem; margin-bottom: 2rem; }
    .hero-tag-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--amber); flex-shrink: 0; }
    .hero-tag-text { font-size: .68rem; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; color: rgba(245,241,233,.7); }
    .hero-headline { color: #fff; margin-bottom: 1.5rem; }
    .hero-headline em { color: var(--amber-l); font-style: italic; }
    .hero-sub { font-size: .95rem; line-height: 1.85; color: rgba(245,241,233,.72); margin-bottom: 2.75rem; max-width: 48ch; }
    .hero-actions { display: flex; gap: .9rem; flex-wrap: wrap; }
    /* Floating data strip */
    .hero-strip { position: absolute; bottom: 0; left: 0; right: 0; z-index: 2; display: flex; }
    .hero-strip-item { flex: 1; padding: 1.5rem 2rem; background: rgba(245,241,233,.08); backdrop-filter: blur(6px); border-top: 1px solid rgba(245,241,233,.1); border-right: 1px solid rgba(245,241,233,.08); text-align: center; }
    .strip-val { font-family: var(--fd); font-size: 2rem; font-weight: 300; color: var(--amber-l); }
    .strip-lbl { font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; color: rgba(245,241,233,.45); margin-top: .2rem; }

    /* ── About ──── */
    .about { padding: 9rem 0; }
    .about-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 8rem; align-items: center; }
    .about-img-col { position: relative; }
    .about-img { width: 100%; aspect-ratio: 3/4; object-fit: cover; }
    .about-accent-box { position: absolute; top: -1.5rem; right: -1.5rem; width: 120px; height: 120px; background: var(--amber); opacity: .15; }
    .about-sea-box { position: absolute; bottom: -1.5rem; left: -1.5rem; width: 80px; height: 80px; background: var(--sea); opacity: .2; }
    .about-eyebrow { margin-bottom: 1.25rem; }
    .about-title { margin-bottom: 1.5rem; }
    .about-title em { color: var(--amber); font-style: italic; }
    .about-p + .about-p { margin-top: 1.1rem; }
    .about-stats { display: flex; gap: 3rem; margin: 2.5rem 0; padding: 2rem 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .a-stat-val { font-family: var(--fd); font-size: 2.4rem; font-weight: 300; color: var(--amber); }
    .a-stat-lbl { font-size: .65rem; letter-spacing: .13em; text-transform: uppercase; color: var(--muted); margin-top: .2rem; }

    /* ── Courses — magazine layout ──── */
    .courses { background: var(--ink); padding: 7rem 0; }
    .courses-hd { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 4rem; padding-bottom: 2rem; border-bottom: 1px solid rgba(255,255,255,.08); }
    .courses-hd-eyebrow { color: var(--amber) !important; margin-bottom: .75rem; }
    .courses-hd-title { color: #fff; }
    .course-mag { display: grid; grid-template-columns: repeat(3,1fr); gap: 2px; }
    .cm-item { background: var(--ink-l); padding: 2.5rem 2.2rem; display: flex; flex-direction: column; border-left: 2px solid transparent; transition: border-color .2s, background .2s; }
    .cm-item:hover { border-left-color: var(--amber); background: #1E2E20; }
    .cm-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; }
    .cm-num { font-family: var(--fd); font-size: 2.5rem; font-weight: 300; color: rgba(255,255,255,.08); line-height: 1; }
    .cm-tag { font-size: .6rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--amber); background: rgba(196,131,74,.12); padding: .3rem .65rem; }
    .cm-title { font-family: var(--fd); font-size: 1.5rem; font-weight: 400; color: #fff; margin-bottom: .75rem; line-height: 1.2; }
    .cm-desc { font-size: .82rem; line-height: 1.75; color: rgba(245,241,233,.5); flex: 1; margin-bottom: 1.5rem; }
    .cm-cta { font-size: .66rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--sea-l); text-decoration: none; }

    /* ── GYG ──── */
    .gyg { padding: 7rem 0; border-top: 1px solid var(--border); }
    .gyg-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: stretch; }
    .gyg-img-side { position: relative; overflow: hidden; min-height: 500px; }
    .gyg-img { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
    .gyg-img-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(14,22,16,.7) 0%, transparent 60%); }
    .gyg-img-text { position: absolute; bottom: 2rem; left: 2rem; right: 2rem; }
    .gyg-img-quote { font-family: var(--fd); font-size: 1.2rem; font-style: italic; font-weight: 300; color: rgba(255,255,255,.85); }
    .gyg-text-side { display: flex; flex-direction: column; justify-content: center; padding: 2rem 0; }
    .gyg-eyebrow { margin-bottom: 1.25rem; }
    .gyg-title { margin-bottom: 1.5rem; }
    .gyg-title em { color: var(--sea); font-style: italic; }
    .gyg-body { margin-bottom: 2.5rem; max-width: 44ch; }
    .gyg-actions { display: flex; gap: 1rem; }

    /* ── Gallery ──── */
    .gallery { background: var(--linen-d); padding: 7rem 0; }
    .gallery-hd { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2.5rem; }
    .gal-masonry { columns: 4; gap: 4px; }
    .gal-item { break-inside: avoid; margin-bottom: 4px; overflow: hidden; display: block; }
    .gal-img { width: 100%; display: block; transition: transform .5s; }
    .gal-item:hover .gal-img { transform: scale(1.04); }

    /* ── Footer ──── */
    .footer { background: var(--ink); padding: 4.5rem 0; }
    .footer-inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem; }
    .footer-logo { font-family: var(--fd); font-size: 1rem; font-weight: 300; color: rgba(245,241,233,.6); }
    .footer-links { display: flex; gap: 2rem; justify-content: center; }
    .footer-links a { font-size: .65rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(245,241,233,.35); text-decoration: none; transition: color .15s; }
    .footer-links a:hover { color: rgba(245,241,233,.75); }
    .footer-right { text-align: right; font-size: .65rem; color: rgba(245,241,233,.25); }
  </style>
</head>
<body>

<div class="pbar">
  <span class="pbar-label">Style Preview</span>
  <a href="/preview/deia">Deià — Gallery Minimal</a>
  <a href="/preview/tramuntana">Tramuntana — Warm &amp; Dark</a>
  <a href="/preview/ponent" class="active">Ponent — Cinematic Island</a>
</div>

<header class="site-header">
  <div class="wrap header-inner">
    <a href="#" class="logo">
      <div class="logo-name">Arte Botanico</div>
      <div class="logo-sub">Mallorca · Art Studio</div>
    </a>
    <nav class="site-nav">
      <a href="#">Home</a><a href="#">Courses</a><a href="#">Gallery</a><a href="#">Contact</a>
    </nav>
    <div class="header-right">
      <a href="#" class="header-lang">DE</a>
      <a href="#" class="btn btn-amber" style="padding:.5rem 1.2rem;font-size:.68rem;">Book Now</a>
    </div>
  </div>
</header>

<!-- Hero -->
<section class="hero">
  <div class="hero-bg">
    <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1600&q=85" alt="Mallorca" />
    <div class="hero-overlay"></div>
  </div>
  <div class="hero-body">
    <div class="hero-inner">
      <div class="hero-tag">
        <span class="hero-tag-dot"></span>
        <span class="hero-tag-text">Art Studio · Mallorca</span>
      </div>
      <h1 class="h1 hero-headline">
        Discover your<br><em>creative side</em><br>in paradise
      </h1>
      <p class="hero-sub">Painting classes, resin workshops &amp; pottery in the heart of Mallorca — for curious beginners and seasoned artists alike.</p>
      <div class="hero-actions">
        <a href="#" class="btn btn-amber">Explore Courses</a>
        <a href="#" class="btn btn-ghost-light">Book via GetYourGuide ↗</a>
      </div>
    </div>
  </div>
  <div class="hero-strip">
    <div class="hero-strip-item"><div class="strip-val">6+</div><div class="strip-lbl">Course types</div></div>
    <div class="hero-strip-item"><div class="strip-val">6</div><div class="strip-lbl">Languages</div></div>
    <div class="hero-strip-item"><div class="strip-val">∞</div><div class="strip-lbl">Creativity</div></div>
    <div class="hero-strip-item" style="flex:2;text-align:left;display:flex;align-items:center;">
      <span style="font-size:.75rem;color:rgba(245,241,233,.5);font-style:italic;font-family:var(--fd);">
        "The light on Mallorca does something to you."
      </span>
    </div>
  </div>
</section>

<!-- About -->
<section class="about">
  <div class="wrap about-inner">
    <div class="about-img-col">
      <img src="https://images.unsplash.com/photo-1547826039-bfc35e0f1ea8?w=900&q=80" alt="Artist" class="about-img" />
      <div class="about-accent-box"></div>
      <div class="about-sea-box"></div>
    </div>
    <div>
      <span class="eyebrow about-eyebrow">Welcome to Arte Botanico</span>
      <h2 class="h2 about-title">Where art meets the <em>soul of Mallorca</em></h2>
      <p class="body-t about-p">Arte Botanico is a warm, welcoming atelier nestled on the beautiful island of Mallorca. Our studio offers a sanctuary where creativity flourishes — surrounded by Mediterranean light, botanical gardens, and the tranquil pace of island life.</p>
      <p class="body-t about-p">Whether you're picking up a brush for the very first time or deepening a lifelong practice, our small-group classes ensure personal attention and the joy of making something beautiful.</p>
      <div class="about-stats">
        <div><div class="a-stat-val">6+</div><div class="a-stat-lbl">Course types</div></div>
        <div><div class="a-stat-val">6</div><div class="a-stat-lbl">Languages</div></div>
        <div><div class="a-stat-val">∞</div><div class="a-stat-lbl">Creativity</div></div>
      </div>
      <a href="#" class="btn btn-outline">About the Studio</a>
    </div>
  </div>
</section>

<!-- Courses -->
<section class="courses">
  <div class="wrap">
    <div class="courses-hd">
      <div>
        <span class="eyebrow courses-hd-eyebrow">What we offer</span>
        <h2 class="h2 courses-hd-title">Courses &amp; Workshops</h2>
      </div>
      <a href="#" class="btn btn-ghost-light">All Courses</a>
    </div>
    <div class="course-mag">
      {[
        ['01','Children & Adults','Acrylic Painting','Layering, texture and colour mixing in a vibrant, supportive environment.'],
        ['02','Children & Adults','Watercolor / Aquarelle','Wet-on-wet, gradients and botanical illustration guided by Mediterranean light.'],
        ['03','Adults only','Resin Art Workshop','Create jewellery, trays and wall art with epoxy resin. No experience needed.'],
        ['04','Adults only','Pottery Workshop','Hand-building with clay — your own ceramic piece to take home.'],
        ['05','All ages','Private Classes at Home','We come to you, anywhere on Mallorca. Fully personalised sessions.'],
        ['06','Residents','Open Studio','Regular sessions for long-term residents — paint together and connect.'],
      ].map(([num, aud, name, desc]) => (
        <div class="cm-item">
          <div class="cm-top">
            <div class="cm-num">{num}</div>
            <span class="cm-tag">{aud}</span>
          </div>
          <div class="cm-title">{name}</div>
          <p class="cm-desc">{desc}</p>
          <a href="#" class="cm-cta">Book this course →</a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- GYG -->
<section class="gyg">
  <div class="wrap gyg-inner">
    <div class="gyg-img-side">
      <img src="https://images.unsplash.com/photo-1490730141103-6cac27aaab94?w=800&q=80" alt="Painting" class="gyg-img" />
      <div class="gyg-img-overlay"></div>
      <div class="gyg-img-text">
        <p class="gyg-img-quote">"Instant booking. Flexible cancellation. Available in your language."</p>
      </div>
    </div>
    <div class="gyg-text-side">
      <span class="eyebrow gyg-eyebrow">Booking Partner</span>
      <h2 class="h2 gyg-title">Book via <em>GetYourGuide</em></h2>
      <p class="body-t gyg-body">Our courses are listed directly on GetYourGuide — the world's leading platform for experiences. Secure, flexible, available in your language.</p>
      <div class="gyg-actions">
        <a href="#" class="btn btn-sea">Find Us on GetYourGuide ↗</a>
        <a href="#" class="btn btn-outline">Contact Us</a>
      </div>
    </div>
  </div>
</section>

<!-- Gallery -->
<section class="gallery">
  <div class="wrap">
    <div class="gallery-hd">
      <div>
        <span class="eyebrow" style="margin-bottom:.6rem;">Our work</span>
        <h2 class="h2">A glimpse into the studio</h2>
      </div>
      <a href="#" class="btn btn-outline">Full Gallery</a>
    </div>
    <div class="gal-masonry">
      <div class="gal-item"><img src="https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?w=600&q=80" alt="Watercolor" class="gal-img" /></div>
      <div class="gal-item"><img src="https://images.unsplash.com/photo-1513364776144-60967b0f800f?w=600&q=80" alt="Painting" class="gal-img" /></div>
      <div class="gal-item"><img src="https://images.unsplash.com/photo-1565193566173-7a0ee3dbe261?w=600&q=80" alt="Pottery" class="gal-img" /></div>
      <div class="gal-item"><img src="https://images.unsplash.com/photo-1460661419201-fd4cecdf8a8b?w=600&q=80" alt="Supplies" class="gal-img" /></div>
      <div class="gal-item"><img src="https://images.unsplash.com/photo-1572635148818-ef6fd45eb394?w=600&q=80" alt="Studio" class="gal-img" /></div>
      <div class="gal-item"><img src="https://images.unsplash.com/photo-1510832842230-87253f48d74f?w=600&q=80" alt="Botanical" class="gal-img" /></div>
      <div class="gal-item"><img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600&q=80" alt="Landscape" class="gal-img" /></div>
      <div class="gal-item"><img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&q=80" alt="Mallorca" class="gal-img" /></div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="footer">
  <div class="wrap footer-inner">
    <span class="footer-logo">Arte Botanico · Mallorca</span>
    <div class="footer-links">
      <a href="#">Courses</a><a href="#">Gallery</a><a href="#">Contact</a><a href="#">GetYourGuide</a>
    </div>
    <div class="footer-right">© 2026 Arte Botanico</div>
  </div>
</footer>

</body>
</html>
