---
import PreviewNav from '../../components/PreviewNav.astro';
import PreviewHome from '../../components/PreviewHome.astro';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
  <title>Style Preview: Mediterranean – Arte Botanico</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --pv-bg:            #F7F0E6;
      --pv-bg-alt:        #EDE0CE;
      --pv-accent:        #C17A5A;
      --pv-accent-text:   #ffffff;
      --pv-heading:       #2D2016;
      --pv-body-color:    #4A3728;
      --pv-green:         #6B8F71;
      --pv-font-display:  'Playfair Display', Georgia, serif;
      --pv-font-body:     'Lato', system-ui, sans-serif;
      --pv-radius:        2px;
      --pv-card-radius:   2px;
      --pv-hero-overlay:  linear-gradient(135deg, rgba(45,32,22,.75) 0%, rgba(45,32,22,.42) 60%, rgba(193,122,90,.18) 100%);
      --pv-badge-bg:      rgba(193,122,90,.22);
      --pv-badge-color:   #EDBA9E;
      --pv-badge-border:  rgba(193,122,90,.4);
      --pv-header-bg:     rgba(247,240,230,.95);
      --pv-border:        rgba(232,213,196,.65);
      --pv-card-bg:       #F7F0E6;
      --pv-icon-bg:       rgba(193,122,90,.15);
      --pv-deco-1:        #D9A088;
      --pv-deco-2:        #9AB59F;
      --pv-gyg-bg:        #6B8F71;
      --pv-gyg-color:     #527A58;
    }

    body { background: var(--pv-bg); color: var(--pv-body-color); font-family: var(--pv-font-body); }
  </style>
</head>
<body>
  <PreviewNav current="mediterranean" />
  <PreviewHome />
</body>
</html>
